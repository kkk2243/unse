---
import { sceneSvg } from '../art/characters';
import { CATEGORIES } from '../config/site';
import type { CatalogItem } from '../data/catalog';

interface Props {
  items: CatalogItem[];
  showCategory?: boolean;
}
const { items, showCategory = false } = Astro.props;
---

<ul class="rows">
  {
    items.map((item) => {
      const cat = CATEGORIES[item.cats[0]];
      return (
        <li>
          <a href={item.path} class="row-link">
            <span class="thumb" set:html={sceneSvg({ chars: item.chars.slice(0, 1), theme: item.theme })} />
            <span class="min-w-0 flex-1">
              <span class="row-title block text-[16.5px] font-semibold leading-snug">{item.title}</span>
              <span class="mt-0.5 block text-[14px] leading-snug text-ink-2">
                {showCategory && (
                  <span style={`color:${cat.color}`} class="font-semibold">
                    {cat.short}{' '}
                  </span>
                )}
                {item.summary}
              </span>
            </span>
            <svg width="8" height="14" viewBox="0 0 8 14" class="flex-none text-ink-3" aria-hidden="true">
              <path d="M1 1l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
          </a>
        </li>
      );
    })
  }
</ul>
