---
import { SITE, CATEGORIES } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="col pb-8 pt-10 text-[13.5px] text-ink-2">
  <nav aria-label="카테고리" class="flex flex-wrap gap-x-5 gap-y-2 font-semibold text-ink">
    {
      Object.values(CATEGORIES).map((c) => (
        <a href={`/category/${c.key}/`} class="hover:underline">
          {c.name}
        </a>
      ))
    }
    <a href="/zodiac/" class="hover:underline">띠별 운세</a>
    <a href="/ilju/" class="hover:underline">일주 도감</a>
    <a href="/dream/" class="hover:underline">꿈해몽</a>
    <a href="/baby-name/" class="hover:underline">아기 이름</a>
    <a href="/guide/" class="hover:underline">사주 백과</a>
  </nav>
  <p class="mt-4 leading-relaxed">
    {SITE.name}의 모든 결과는 재미로 보는 콘텐츠예요. 실제 성격이나 미래를 판단하는 근거로 쓰지 말아 주세요. 이름과 생년월일은 서버로 보내지 않고
    이 기기 안에서만 계산해요.
  </p>
  <nav aria-label="사이트 정보" class="mt-4 flex flex-wrap gap-x-4 gap-y-1.5">
    <a href="/about/" class="hover:underline">사이트 소개</a>
    <a href="/privacy/" class="font-semibold text-ink hover:underline">개인정보처리방침</a>
    <a href="/terms/" class="hover:underline">이용약관</a>
    <a href="/contact/" class="hover:underline">문의</a>
  </nav>
  <p class="mt-4 text-ink-3">© {year} {SITE.name}</p>
</footer>
