---
// 궁합 초대장 보내기 카드
import { charSvg } from '../art/characters';
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<section class="card invite-box">
  <div class="flex items-center gap-3">
    <span class="block h-16 w-16 flex-none" set:html={charSvg('rabbit', 'happy')} />
    <div>
      <h2 class="card-title">궁합 초대장 보내기</h2>
      <p class="mt-1 text-[14.5px] leading-relaxed text-ink-2">링크를 받은 사람은 자기 생일만 넣으면 바로 우리 둘의 궁합을 볼 수 있어요.</p>
    </div>
  </div>
  <button type="button" class="btn btn-primary btn-block mt-4" data-invite>초대장 보내기</button>
  <a href="/me/" class="btn btn-line btn-block mt-4" data-invite-need hidden>먼저 내 정보 등록하기</a>
  {!compact && <p class="mt-3 text-[13px] leading-relaxed text-ink-3">초대장 링크에는 내 이름과 생년월일이 담겨요. 믿을 수 있는 사람에게만 보내 주세요. 서버에는 저장되지 않아요.</p>}
</section>

<script>
  import { currentProfile, honor } from '../lib/profile';
  import { inviteUrl } from '../lib/invite';
  import { shareLink } from '../lib/share';

  document.querySelectorAll<HTMLElement>('.invite-box').forEach((box) => {
    const btn = box.querySelector<HTMLButtonElement>('[data-invite]')!;
    const need = box.querySelector<HTMLElement>('[data-invite-need]')!;
    const cp = currentProfile();
    if (!cp) {
      btn.hidden = true;
      need.hidden = false;
      return;
    }
    btn.textContent = `${honor(cp.name)} 이름으로 초대장 보내기`;
    btn.addEventListener('click', () => {
      const { id: _id, ...p } = cp;
      shareLink({
        title: `${honor(cp.name)}이 사주 궁합 초대장을 보냈어요`,
        text: '내 생일만 넣으면 우리 둘의 궁합 점수가 바로 나와요',
        url: inviteUrl(p) + '&utm_source=invite&utm_medium=share&utm_campaign=gunghap-invite',
        image: new URL('/og/invite.png', location.origin).href,
        button: '우리 궁합 보기',
        campaign: 'gunghap-invite',
      });
    });
  });
</script>
