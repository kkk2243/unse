---
import Logo from './Logo.astro';
import { SITE } from '../config/site';

interface Props {
  back?: string; // 뒤로 가기 주소 (하위 페이지)
  title?: string; // 하위 페이지 머리말 제목
}
const { back, title } = Astro.props;
---

<header class="hdr">
  <div class="col flex h-14 items-center justify-between gap-2">
    {
      back ? (
        <div class="flex min-w-0 items-center gap-1">
          <a href={back} class="icon-btn -ml-2.5" aria-label="뒤로 가기">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <span class="truncate text-[17px] font-bold">{title}</span>
        </div>
      ) : (
        <a href="/" class="flex items-center gap-2" aria-label={`${SITE.name} 처음으로`}>
          <Logo size={34} />
          <span class="font-display text-[20px] font-extrabold tracking-tight">{SITE.name}</span>
        </a>
      )
    }
    <div class="flex items-center">
      <button type="button" id="theme-toggle" class="icon-btn" aria-label="화면 밝기 바꾸기">
        <svg class="theme-icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
        </svg>
        <svg class="theme-icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"></circle>
          <path
            d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path>
        </svg>
      </button>
      <a href="/me/" class="icon-btn -mr-2" aria-label="내 정보">
        <span class="me-dot" data-me-initial>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="8.5" r="4" stroke="currentColor" stroke-width="2"></circle>
            <path d="M4.5 20.5c0-4.5 3.3-7 7.5-7s7.5 2.5 7.5 7" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </span>
      </a>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--app-bg) 92%, transparent);
    backdrop-filter: blur(10px);
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: var(--ink-2);
  }
  .icon-btn:hover {
    background: var(--wash);
  }
  .me-dot {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    font-size: 13px;
    font-weight: 800;
  }
  .theme-icon-sun {
    display: none;
  }
  :global([data-theme='dark']) .theme-icon-sun {
    display: block;
  }
  :global([data-theme='dark']) .theme-icon-moon {
    display: none;
  }
</style>

<script>
  import { currentProfile } from '../lib/profile';
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('saju.theme', next);
    } catch {}
  });
  const p = currentProfile();
  const dot = document.querySelector<HTMLElement>('[data-me-initial]');
  if (p && dot && p.name) dot.textContent = [...p.name][0];
</script>
