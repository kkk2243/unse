---
// '풀이하고 있어요' 화면. 진행 막대가 다 차면 결과 보기 버튼이 나옵니다.
// 결과는 별도 페이지(링크 이동)로 열려서, 애드센스 비네트 광고와 오퍼월을 쓸 수 있어요.
import AdSlot from './AdSlot.astro';
import { charSvg } from '../art/characters';
---

<div class="gate" id="gate" hidden role="dialog" aria-modal="true" aria-labelledby="gate-title">
  <div class="gate-panel">
    <button type="button" class="gate-close" data-gate-close aria-label="닫기">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg
      >
    </button>
    <p id="gate-title" class="gate-title"><b data-gate-name></b><span data-gate-label></span></p>

    <div class="gate-stage" aria-hidden="true">
      <span class="orbit">
        <span class="o o1" data-orbit></span>
        <span class="o o2" data-orbit></span>
        <span class="o o3" data-orbit></span>
      </span>
      <span class="owl" set:html={charSvg('owl', 'normal')} />
      <span class="glass">
        <svg viewBox="0 0 48 48"><circle cx="20" cy="20" r="12" fill="#fff" fill-opacity=".55" stroke="#3b2f3f" stroke-width="3.4"></circle><path d="M29 29 l11 11" stroke="#3b2f3f" stroke-width="5" stroke-linecap="round"></path></svg>
      </span>
    </div>

    <div class="gate-progress">
      <div class="bar" style="--bar-c:var(--jusa)"><i data-gate-bar style="width:0;animation:none"></i></div>
      <p class="mt-2 flex justify-between text-[14px] font-semibold text-ink-2">
        <span data-gate-step>사주 여덟 글자를 세우는 중</span>
        <span class="font-display text-ink" data-gate-pct>0%</span>
      </p>
    </div>

    <a class="btn btn-primary btn-block gate-go" data-gate-go hidden href="#">결과 보기</a>

    <div class="gate-tip">
      <p class="text-[13px] font-bold text-jusa">알고 보면 더 재밌는 사주 상식</p>
      <p class="mt-1 text-[14.5px] leading-relaxed" data-gate-tip></p>
    </div>

    <div class="gate-ad">
      <AdSlot name="gate" format="rectangle" lazy />
    </div>
  </div>
</div>

<style>
  .gate {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: rgb(16 17 28 / 0.55);
    display: flex;
    justify-content: center;
  }
  .gate[hidden] {
    display: none;
  }
  .gate-panel {
    position: relative;
    width: 100%;
    max-width: 480px;
    height: 100%;
    overflow-y: auto;
    background: var(--app-bg);
    padding: 56px 20px calc(28px + env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .gate-close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--ink-2);
  }
  .gate-title {
    text-align: center;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.5;
  }
  .gate-title b {
    font-weight: 800;
  }
  .gate-stage {
    position: relative;
    width: 200px;
    height: 200px;
    margin: 0 auto;
  }
  .owl {
    position: absolute;
    inset: 40px;
  }
  .owl :global(svg),
  .o :global(svg),
  .glass svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .glass {
    position: absolute;
    width: 54px;
    height: 54px;
    right: 26px;
    bottom: 30px;
  }
  .orbit {
    position: absolute;
    inset: 0;
  }
  .o {
    position: absolute;
    width: 50px;
    height: 50px;
    left: 75px;
    top: 75px;
  }
  .o1 {
    transform: rotate(0deg) translateX(92px) rotate(0deg);
  }
  .o2 {
    transform: rotate(120deg) translateX(92px) rotate(-120deg);
  }
  .o3 {
    transform: rotate(240deg) translateX(92px) rotate(-240deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .orbit {
      animation: spin 9s linear infinite;
    }
    .o :global(svg) {
      animation: spin 9s linear infinite reverse;
    }
    .owl {
      animation: bob 1.4s ease-in-out infinite alternate;
    }
    .glass {
      animation: scan 2.2s ease-in-out infinite alternate;
    }
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes bob {
    to {
      transform: translateY(-6px);
    }
  }
  @keyframes scan {
    from {
      transform: translate(-60px, -40px) rotate(-10deg);
    }
    to {
      transform: translate(0, 0) rotate(6deg);
    }
  }
  .gate-progress {
    background: var(--card);
    border-radius: 18px;
    padding: 16px;
    box-shadow: var(--shadow);
  }
  .gate-progress .bar > i {
    transition: width 0.25s linear;
  }
  .gate-go {
    box-shadow: 0 10px 24px -12px rgb(31 32 51 / 0.6);
  }
  .gate-ad {
    display: flex;
    justify-content: center;
  }
  .gate-ad :global(.ad-slot) {
    margin: 0;
  }
  .gate-tip {
    background: var(--card);
    border-radius: 18px;
    padding: 14px 16px;
  }
</style>
