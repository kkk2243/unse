---
// 생년월일을 입력받아 분석 중 화면을 거쳐 결과 페이지로 보내는 공통 입력 화면
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import ProfileForm from './ProfileForm.astro';
import Faq from './Faq.astro';
import Related from './Related.astro';
import Disclaimer from './Disclaimer.astro';
import AdSlot from './AdSlot.astro';
import Gate from './Gate.astro';
import { faqLd } from '../lib/seo';
import { catalogById } from '../data/catalog';

interface Props {
  id: string;
  title: string;
  heroTitle?: string;
  lead: string;
  desc: string;
  articleTitle: string;
  article: string[];
  faq: { q: string; a: string }[];
  kind: string;
  resultPath: string;
  gateLabel: string;
  gateSteps?: string[];
  submitLabel: string;
  two?: boolean;
  years?: number[];
  defaultYear?: number;
  ogImage?: string;
  chars?: string[];
}
const p = Astro.props;
const item = catalogById(p.id);
---

<Base
  title={p.title}
  description={p.desc}
  ogImage={p.ogImage ?? `/og/test-${p.id}.png`}
  crumbs={[{ name: item.cats[0] === 'love' ? '궁합' : '사주·운세', path: `/category/${item.cats[0]}/` }, { name: p.title, path: item.path }]}
  jsonLd={[faqLd(p.faq)]}
>
  <div class="col pt-2">
    <PageHero title={p.heroTitle ?? p.title} lead={p.lead} chars={p.chars ?? item.chars} theme={item.theme} />

    <form
      class="card mt-3"
      id="in-form"
      novalidate
      data-kind={p.kind}
      data-result={p.resultPath}
      data-label={p.gateLabel}
      data-steps={JSON.stringify(p.gateSteps ?? [])}
      data-two={p.two ? '1' : undefined}
      data-test={p.id}
      data-chars={JSON.stringify(p.chars ?? item.chars)}
    >
      {
        p.years && (
          <div class="mb-5">
            <span class="field-label">운세를 볼 해</span>
            <div class="seg" role="radiogroup" aria-label="연도">
              {p.years.map((y) => (
                <label>
                  <input type="radio" name="year" value={y} checked={y === p.defaultYear} />
                  {y}년
                </label>
              ))}
            </div>
          </div>
        )
      }
      <ProfileForm prefix="pa" who={p.two ? '나' : undefined} />
      {
        p.two && (
          <div class="mt-7 border-t border-line pt-6">
            <ProfileForm prefix="pb" who="상대" save={false} />
          </div>
        )
      }
      <p class="mt-3 min-h-[20px] text-[13.5px] font-semibold text-jusa" id="in-error" role="alert"></p>
      <button type="submit" class="btn btn-primary btn-block mt-1">{p.submitLabel}</button>
    </form>

    <AdSlot name="test-intro" />

    <article class="card prose-lab">
      <h2>{p.articleTitle}</h2>
      {p.article.map((t) => <p>{t}</p>)}
      <slot name="article" />
    </article>

    <section class="card" aria-labelledby="faq">
      <h2 id="faq" class="card-title">자주 묻는 질문</h2>
      <Faq items={p.faq} />
    </section>

    <slot />

    <Related id={p.id} />
    <Disclaimer />
  </div>
  <Gate slot="overlay" />
</Base>

<script>
  import { readProfileForm } from '../lib/profile-form';
  import { saveProfile, setPending, honor } from '../lib/profile';
  import { openGate } from '../lib/gate';

  const form = document.getElementById('in-form') as HTMLFormElement;
  const err = document.getElementById('in-error')!;
  const ds = form.dataset;

  // 주소에 ?year=2027 이 있으면 그 해를 미리 고름
  const qy = new URLSearchParams(location.search).get('year');
  if (qy) {
    const r = form.querySelector<HTMLInputElement>(`input[name=year][value="${qy}"]`);
    if (r) r.checked = true;
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const a = readProfileForm(form, 'pa');
    if (typeof a === 'string') return void (err.textContent = ds.two ? `나: ${a}` : a);
    let b: ReturnType<typeof readProfileForm> | undefined;
    if (ds.two) {
      b = readProfileForm(form, 'pb');
      if (typeof b === 'string') return void (err.textContent = `상대: ${b}`);
    }
    err.textContent = '';
    const { save, ...pa } = a;
    if (save) saveProfile(pa);
    const pb = b && typeof b !== 'string' ? (({ save: _s, ...rest }) => rest)(b) : undefined;
    const yearEl = form.elements.namedItem('year') as RadioNodeList | null;
    const year = yearEl ? Number(yearEl.value) : undefined;
    setPending({ kind: ds.kind!, a: pa, b: pb, year });
    const label = (ds.label ?? '').replace('{year}', String(year ?? ''));
    openGate({
      name: pb ? `${honor(pa.name)}과 ${honor(pb.name)}의 ` : `${honor(pa.name)}의 `,
      label,
      steps: JSON.parse(ds.steps || '[]').length ? JSON.parse(ds.steps!) : undefined,
      href: ds.result! + (year ? `?year=${year}` : ''),
      chars: JSON.parse(ds.chars || '[]'),
      test: ds.test,
    });
  });
</script>
