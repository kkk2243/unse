---
// 생년월일을 입력받아 분석 중 화면을 거쳐 결과 페이지로 보내는 공통 입력 화면
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import ProfileForm from './ProfileForm.astro';
import Faq from './Faq.astro';
import Related from './Related.astro';
import Disclaimer from './Disclaimer.astro';
import AdSlot from './AdSlot.astro';
import Gate from './Gate.astro';
import { faqLd } from '../lib/seo';
import { catalogById } from '../data/catalog';
import { charSvg } from '../art/characters';

interface Props {
  id: string;
  title: string;
  heroTitle?: string;
  lead: string;
  desc: string;
  articleTitle: string;
  article: string[];
  faq: { q: string; a: string }[];
  kind: string;
  resultPath: string;
  gateLabel: string;
  gateSteps?: string[];
  submitLabel: string;
  two?: boolean;
  years?: number[];
  defaultYear?: number;
  ogImage?: string;
  chars?: string[];
}
const p = Astro.props;
const item = catalogById(p.id);
---

<Base
  title={p.title}
  description={p.desc}
  ogImage={p.ogImage ?? `/og/test-${p.id}.png`}
  crumbs={[{ name: item.cats[0] === 'love' ? '궁합' : '사주·운세', path: `/category/${item.cats[0]}/` }, { name: p.title, path: item.path }]}
  jsonLd={[faqLd(p.faq)]}
>
  <div class="col pt-2">
    <PageHero title={p.heroTitle ?? p.title} lead={p.lead} chars={p.chars ?? item.chars} theme={item.theme} />

    <form
      class="card mt-3"
      id="in-form"
      novalidate
      data-kind={p.kind}
      data-result={p.resultPath}
      data-label={p.gateLabel}
      data-steps={JSON.stringify(p.gateSteps ?? [])}
      data-two={p.two ? '1' : undefined}
      data-test={p.id}
      data-chars={JSON.stringify(p.chars ?? item.chars)}
    >
      {p.years && p.years.length === 1 && <input type="hidden" name="year" value={p.years[0]} />}
      {
        p.years && p.years.length > 1 && (
          <div class="mb-5">
            <span class="field-label">운세를 볼 해</span>
            <div class="seg" role="radiogroup" aria-label="연도">
              {p.years.map((y) => (
                <label>
                  <input type="radio" name="year" value={y} checked={y === p.defaultYear} />
                  {y}년
                </label>
              ))}
            </div>
          </div>
        )
      }
      {
        p.two && (
          <div id="invite-banner" hidden class="mb-6 flex items-center gap-3 rounded-[16px] bg-[var(--wash)] p-4">
            <span class="block h-14 w-14 flex-none" set:html={charSvg('rabbit', 'happy')} />
            <p class="text-[15px] leading-relaxed">
              <b class="block text-[16.5px]" data-invite-title />
              <span class="text-ink-2" data-invite-sub />
            </p>
          </div>
        )
      }
      <ProfileForm prefix="pa" who={p.two ? '나' : undefined} />
      {
        p.two && (
          <div class="mt-7 border-t border-line pt-6" id="pb-wrap">
            <ProfileForm prefix="pb" who="상대" save={false} />
          </div>
        )
      }
      <slot name="fields" />
      <p class="mt-3 min-h-[20px] text-[13.5px] font-semibold text-jusa" id="in-error" role="alert"></p>
      <button type="submit" class="btn btn-primary btn-block mt-1">{p.submitLabel}</button>
    </form>

    <AdSlot name="test-intro" />

    <article class="card prose-lab">
      <h2>{p.articleTitle}</h2>
      {p.article.map((t) => <p>{t}</p>)}
      <slot name="article" />
    </article>

    <section class="card" aria-labelledby="faq">
      <h2 id="faq" class="card-title">자주 묻는 질문</h2>
      <Faq items={p.faq} />
    </section>

    <slot />

    <Related id={p.id} />
    <Disclaimer />
  </div>
  <Gate slot="overlay" />
</Base>

<script>
  import { readProfileForm } from '../lib/profile-form';
  import { saveProfile, setPending, honor } from '../lib/profile';
  import { openGate } from '../lib/gate';
  import { decodeInvite } from '../lib/invite';

  const form = document.getElementById('in-form') as HTMLFormElement;
  const err = document.getElementById('in-error')!;
  const ds = form.dataset;

  // 궁합 초대장으로 들어온 경우: 상대 정보는 초대장에서 가져오고 내 정보만 받음
  const inviteCode = (() => {
    const w = (window as unknown as { __sajuInvite?: string }).__sajuInvite;
    if (w) return w;
    try {
      return sessionStorage.getItem('saju.invite');
    } catch {
      return null;
    }
  })();
  const invite = ds.two && inviteCode ? decodeInvite(inviteCode) : null;
  if (invite) {
    document.getElementById('pb-wrap')!.hidden = true;
    const banner = document.getElementById('invite-banner')!;
    banner.hidden = false;
    banner.querySelector('[data-invite-title]')!.textContent = `${honor(invite.name)}이 궁합 초대장을 보냈어요`;
    banner.querySelector('[data-invite-sub]')!.textContent = `${honor(invite.name)}의 생년월일은 초대장에 담겨 있어요. 내 정보만 넣으면 바로 우리 궁합이 나와요.`;
  }

  // 주소에 ?year=2027 이 있으면 그 해를 미리 고름
  const qy = new URLSearchParams(location.search).get('year');
  if (qy) {
    const r = form.querySelector<HTMLInputElement>(`input[name=year][value="${qy}"]`);
    if (r) r.checked = true;
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const a = readProfileForm(form, 'pa');
    if (typeof a === 'string') return void (err.textContent = ds.two ? `나: ${a}` : a);
    let b: ReturnType<typeof readProfileForm> | undefined;
    if (ds.two && !invite) {
      b = readProfileForm(form, 'pb');
      if (typeof b === 'string') return void (err.textContent = `상대: ${b}`);
    }
    // 추가 입력값 (예: MBTI)
    const extra: Record<string, string> = {};
    for (const el of form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-extra]')) {
      if (!el.value && el.required) return void (err.textContent = el.dataset.extra || '빈칸을 채워 주세요');
      extra[el.name] = el.value;
    }
    err.textContent = '';
    const { save, ...pa } = a;
    if (save) saveProfile(pa);
    const pb = invite ?? (b && typeof b !== 'string' ? (({ save: _s, ...rest }) => rest)(b) : undefined);
    const yearEl = form.elements.namedItem('year') as RadioNodeList | null;
    const year = yearEl ? Number(yearEl.value) : undefined;
    setPending({ kind: ds.kind!, a: pa, b: pb, year, extra });
    if (invite) {
      try {
        sessionStorage.removeItem('saju.invite');
      } catch {}
    }
    const label = (ds.label ?? '').replace('{year}', String(year ?? ''));
    openGate({
      name: pb ? `${honor(pa.name)}과 ${honor(pb.name)}의 ` : `${honor(pa.name)}의 `,
      label,
      steps: JSON.parse(ds.steps || '[]').length ? JSON.parse(ds.steps!) : undefined,
      href: ds.result! + (year ? `?year=${year}` : ''),
      chars: JSON.parse(ds.chars || '[]'),
      test: ds.test,
    });
  });
</script>
