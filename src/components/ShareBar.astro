---
import { ENV, KAKAO_SDK_VERSION } from '../config/site';
import type { TalismanData } from '../lib/talisman-image';

interface Props {
  title: string; // 공유 미리보기 제목
  text: string; // 공유 미리보기 설명
  path?: string; // 공유할 주소 (기본: 현재 페이지)
  ctaPath?: string; // 카톡 버튼 '나도 해보기'가 여는 주소
  ogImage?: string;
  campaign: string; // utm_campaign 값 (테스트 id)
  talisman?: TalismanData;
  id?: string;
}

const { title, text, path, ctaPath, ogImage = '/og/default.png', campaign, talisman, id } = Astro.props;
const site = Astro.site!;
const data = {
  title,
  text,
  url: new URL(path ?? Astro.url.pathname, site).pathname,
  cta: new URL(ctaPath ?? path ?? Astro.url.pathname, site).pathname,
  image: new URL(ogImage, site).href,
  campaign,
  talisman: talisman ?? null,
};
---

<div class="share-bar" id={id} data-share={JSON.stringify(data)}>
  <div class="grid grid-cols-4 gap-2 text-center">
    <button type="button" data-act="kakao" class="share-btn">
      <span class="share-ico" style="background:#FEE500;color:#191919">
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M12 3.6c-5 0-9 3.1-9 7 0 2.5 1.7 4.7 4.2 6l-.9 3.4c-.1.3.3.6.6.4l4-2.6h1.1c5 0 9-3.1 9-7s-4-7.2-9-7.2Z"
          ></path></svg
        >
      </span>
      <span class="share-label">카카오톡</span>
    </button>
    <button type="button" data-act="copy" class="share-btn">
      <span class="share-ico">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"
          ><path
            d="M10.2 13.8a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1.1 1.1M13.8 10.2a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1.1-1.1"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"></path></svg
        >
      </span>
      <span class="share-label">링크 복사</span>
    </button>
    <button type="button" data-act="image" class="share-btn" disabled={!talisman}>
      <span class="share-ico" style="background:var(--hwang);color:#b3261a">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"
          ><rect x="6" y="2.8" width="12" height="18.4" rx="1" stroke="currentColor" stroke-width="1.9"></rect><path
            d="M9 7.5h6M9 11h6M12 14.5v3"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"></path></svg
        >
      </span>
      <span class="share-label">부적 저장</span>
    </button>
    <button type="button" data-act="more" class="share-btn">
      <span class="share-ico">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"
          ><path
            d="M12 3.5v11M8 7.2l4-3.7 4 3.7M6.5 11H5.8A1.8 1.8 0 0 0 4 12.8v6.4A1.8 1.8 0 0 0 5.8 21h12.4a1.8 1.8 0 0 0 1.8-1.8v-6.4a1.8 1.8 0 0 0-1.8-1.8h-.7"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </span>
      <span class="share-label">다른 앱</span>
    </button>
  </div>
</div>

<dialog class="img-dialog" aria-label="부적 이미지 저장">
  <div class="img-dialog-body">
    <div class="img-wrap">
      <p class="img-loading">부적 쓰는 중</p>
      <img alt="저장할 부적 이미지" hidden />
    </div>
    <p class="mt-3 text-center text-[14px] text-white/80">이미지를 길게 눌러 저장할 수도 있어요</p>
    <div class="mt-3 grid grid-cols-2 gap-2">
      <a class="btn btn-sm img-download" style="background:#fff;color:#1c1d2b" download="saju-bujeok.jpg">저장하기</a>
      <button type="button" class="btn btn-sm img-share" style="background:var(--hwang);color:#3b2810">공유하기</button>
    </div>
    <button type="button" class="img-close" aria-label="닫기">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg
      >
    </button>
  </div>
</dialog>

{
  ENV.kakaoJsKey && (
    <script
      is:inline
      async
      src={`https://t1.kakaocdn.net/kakao_js_sdk/${KAKAO_SDK_VERSION}/kakao.min.js`}
      crossorigin="anonymous"
      data-kakao-key={ENV.kakaoJsKey}
      id="kakao-sdk"
    />
  )
}

<style>
  .share-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    padding: 6px 0;
    border-radius: 12px;
    cursor: pointer;
  }
  .share-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .share-btn:not(:disabled):active .share-ico {
    transform: scale(0.94);
  }
  .share-ico {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--wash);
    color: var(--ink);
    transition: transform 0.12s ease;
  }
  .share-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .img-dialog {
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    background: transparent;
    border: 0;
  }
  .img-dialog::backdrop {
    background: rgb(12 12 18 / 0.86);
  }
  .img-dialog-body {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 56px 24px calc(28px + env(safe-area-inset-bottom));
    max-width: 420px;
    margin: 0 auto;
  }
  .img-wrap {
    display: grid;
    place-items: center;
    aspect-ratio: 9 / 16;
    height: min(66vh, 600px);
    max-width: 100%;
    background: #f1cc45;
    border-radius: 4px;
    overflow: hidden;
  }
  .img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .img-loading {
    color: #b3261a;
    font-weight: 700;
  }
  .img-close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: #fff;
    border-radius: 50%;
  }
</style>

<script>
  import { initShareBars } from '../lib/share';
  initShareBars();
</script>
