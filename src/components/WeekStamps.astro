---
// 이번 주 출석 도장 7칸. 화면에 그린 뒤 브라우저에서 기록을 읽어 채웁니다.
interface Props {
  size?: 'sm' | 'md';
}
const { size = 'sm' } = Astro.props;
const labels = ['월', '화', '수', '목', '금', '토', '일'];
---

<div class:list={['week-stamps', `ws-${size}`]} data-week-stamps>
  <ol class="ws-row">
    {
      labels.map((l) => (
        <li class="ws-cell">
          <span class="ws-dot" />
          <span class="ws-label">{l}</span>
        </li>
      ))
    }
  </ol>
  <p class="ws-msg">출석 도장은 오늘의 운세를 볼 때 찍혀요</p>
</div>

<style>
  .ws-row {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }
  .ws-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .ws-dot {
    position: relative;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1.5px dashed var(--line);
  }
  .ws-md .ws-dot {
    width: 34px;
    height: 34px;
  }
  .ws-label {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--ink-3);
  }
  .ws-md .ws-label {
    font-size: 13px;
  }
  .ws-cell[data-today] .ws-dot {
    border: 1.5px solid var(--ink);
  }
  .ws-cell[data-today] .ws-label {
    color: var(--ink);
  }
  .ws-cell[data-done] .ws-dot {
    border: 0;
    background: var(--jusa);
    border-radius: 5px;
    transform: rotate(-8deg);
  }
  .ws-cell[data-done] .ws-dot::after {
    content: '';
    position: absolute;
    inset: 3px;
    border: 1px solid rgb(255 255 255 / 0.8);
    border-radius: 3px;
  }
  .ws-msg {
    margin-top: 8px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .ws-md .ws-msg {
    font-size: 15px;
    text-align: center;
  }
</style>

<script>
  import { thisWeek, streak, checkedToday } from '../lib/attendance';

  function paint() {
    document.querySelectorAll<HTMLElement>('[data-week-stamps]').forEach((root) => {
      const week = thisWeek();
      root.querySelectorAll<HTMLElement>('.ws-cell').forEach((cell, i) => {
        const w = week[i];
        cell.toggleAttribute('data-done', w.done);
        cell.toggleAttribute('data-today', w.isToday);
        cell.title = w.date;
      });
      const s = streak();
      const msg = root.querySelector('.ws-msg')!;
      if (s === 0) msg.textContent = '오늘 운세를 보면 첫 도장이 찍혀요';
      else if (!checkedToday()) msg.textContent = `${s}일 연속 출석 중. 오늘 도장이 아직 비어 있어요`;
      else if (s === 1) msg.textContent = '오늘 첫 도장을 찍었어요. 내일도 들러 주세요';
      else msg.textContent = `${s}일째 연속 출석 중`;
    });
  }
  paint();
  document.addEventListener('attendance:change', paint);
</script>
