---
import { sceneSvg, THEME_BG, type Theme } from '../art/characters';

interface Props {
  title: string;
  lead: string;
  chars: string[];
  theme: Theme;
  meta?: string;
}
const { title, lead, chars, theme, meta } = Astro.props;
---

<section class="hero" style={`--hb:${THEME_BG[theme].bg}`}>
  <span class="hero-art" set:html={sceneSvg({ chars, theme, plain: true })} />
  <div class="relative">
    <h1 class="hero-title">{title}</h1>
    <p class="hero-lead">{lead}</p>
    {meta && <p class="hero-meta">{meta}</p>}
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-radius: 22px;
    background: var(--hb);
    color: #1f2033;
    /* 그림 아래에서 글이 시작되도록 위쪽 여백을 그림 높이만큼 둡니다 */
    padding: 118px 20px 22px;
  }
  .hero-art {
    position: absolute;
    right: -12px;
    top: -22px;
    width: 152px;
    height: 152px;
  }
  .hero-art :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
    max-width: 9em;
  }
  .hero-lead {
    margin-top: 8px;
    font-size: 15.5px;
    line-height: 1.6;
    font-weight: 500;
    opacity: 0.85;
    max-width: 22em;
  }
  .hero-meta {
    margin-top: 10px;
    font-size: 13.5px;
    font-weight: 700;
    opacity: 0.7;
  }
</style>
