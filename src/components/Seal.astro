---
// 도장 모양 아이콘. 1글자, 2글자(세로쓰기), 4글자(2×2, MBTI)를 지원합니다.
interface Props {
  text: string;
  size?: number;
  color?: string;
  class?: string;
  hwang?: boolean;
}
const { text, size = 44, color, hwang = false } = Astro.props;
const chars = [...text];
const kind = chars.length >= 4 ? 4 : chars.length === 2 || chars.length === 3 ? 2 : 1;
// 4글자 도장은 오른쪽 위부터 세로로 읽는 전통 방식 대신, 알아보기 쉽게 왼쪽 위부터 가로로 배치
const style = `--s:${size}px;${color ? `--c:${color};` : ''}`;
---

<span
  class:list={['seal', `seal-${kind}`, { 'seal-hwang': hwang }, Astro.props.class]}
  style={style}
  aria-hidden="true"
>
  {kind === 4 ? chars.slice(0, 4).map((c) => <span>{c}</span>) : text}
</span>
