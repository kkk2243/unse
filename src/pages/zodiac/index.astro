---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Related from '../../components/Related.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import AdSlot from '../../components/AdSlot.astro';
import { charSvg } from '../../art/characters';
import { YEARS, YEAR_INFO, ZODIAC_BRANCHES, ZODIAC_SLUG } from '../../data/reading';
import { BRANCHES } from '../../data/saju';
import { samjae, samjaeAnimals, yearPillar } from '../../lib/saju';
import { zodiacYearReading } from '../../lib/reading';
---

<Base
  title="2027년 띠별 신년운세"
  description="열두 띠의 2027년 정미년 운세. 쥐띠부터 돼지띠까지 띠별 총운, 재물운, 연애운, 직장운, 건강운과 삼재띠를 한눈에 확인하세요."
  ogImage="/og/test-zodiac.png"
  crumbs={[{ name: '띠별 운세', path: '/zodiac/' }]}
>
  <div class="col pt-2">
    <PageHero title="띠별 신년운세" lead="내 띠를 눌러 2027년 정미년의 흐름을 확인해 보세요." chars={['tiger', 'rabbit', 'dragon', 'pig']} theme="luck" />

    {
      YEARS.map((y) => {
        const yb = yearPillar(y)[1];
        const sj = samjaeAnimals(yb);
        return (
          <section class="card mt-3" aria-labelledby={`z-${y}`}>
            <h2 id={`z-${y}`} class="card-title">
              {y}년 {YEAR_INFO[y].name}
            </h2>
            <p class="card-sub">
              {YEAR_INFO[y].animal}의 해. 삼재띠는 {sj.map((x) => `${BRANCHES[x.branch].animal}띠(${x.kind})`).join(', ')}예요.
            </p>
            <ul class="mt-4 grid grid-cols-3 gap-2">
              {ZODIAC_BRANCHES.map((b) => {
                const r = zodiacYearReading(b, y);
                return (
                  <li>
                    <a href={`/zodiac/${y}/${ZODIAC_SLUG[b]}/`} class="zcell">
                      <span class="zf" set:html={charSvg(ZODIAC_SLUG[b], r.score >= 70 ? 'happy' : 'normal')} />
                      <span class="text-[14px] font-bold">{BRANCHES[b].animal}띠</span>
                      <span class="text-[12.5px] text-ink-2">
                        {r.grade.name}{samjae(b, yb) ? ', 삼재' : ''}
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
            <a href={`/zodiac/${y}/`} class="btn btn-line btn-block mt-3">{y}년 띠별 운세 순위 보기</a>
          </section>
        );
      })
    }

    <AdSlot name="list-infeed" format="fluid" />

    <article class="card prose-lab">
      <h2>띠별 운세는 이렇게 봐요</h2>
      <p>
        띠별 운세는 태어난 해의 지지(띠)와 그해를 다스리는 지지가 어떤 관계인지를 보고 풀어요. 서로 손을 잡는 육합과 한 팀을 이루는 삼합은 좋게 보고,
        정면으로 부딪히는 충이나 서로 어긋나는 원진, 마찰이 생기는 형은 조심할 점으로 봐요.
      </p>
      <p>
        띠만으로 보는 운세는 같은 해에 태어난 모든 사람에게 같은 결과가 나오는 큰 흐름이에요. 생년월일을 넣으면 내 사주 여덟 글자로 더 자세한 신년운세를 볼 수
        있어요.
      </p>
    </article>
    <a href="/newyear/" class="btn btn-primary btn-block mt-3">내 생년월일로 신년운세 보기</a>

    <Related id="zodiac" />
    <Disclaimer />
  </div>
</Base>

<style>
  .zcell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 10px 4px;
    border-radius: 16px;
    background: var(--wash);
  }
  .zf {
    width: 60px;
    height: 60px;
  }
  .zf :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
