---
import Base from '../../../layouts/Base.astro';
import Talisman from '../../../components/Talisman.astro';
import ShareBar from '../../../components/ShareBar.astro';
import Related from '../../../components/Related.astro';
import Disclaimer from '../../../components/Disclaimer.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Faq from '../../../components/Faq.astro';
import { charSvg } from '../../../art/characters';
import { iconSvg } from '../../../art/icons';
import { YEARS, YEAR_INFO, ZODIAC_BRANCHES, ZODIAC_SLUG, SAMJAE_TEXT } from '../../../data/reading';
import { BRANCHES, ELEMENTS } from '../../../data/saju';
import { zodiacYearReading } from '../../../lib/reading';
import { SITE, siteFoot } from '../../../config/site';
import { faqLd } from '../../../lib/seo';

export function getStaticPaths() {
  return YEARS.flatMap((year) => ZODIAC_BRANCHES.map((b) => ({ params: { year: String(year), animal: ZODIAC_SLUG[b] }, props: { year, branch: b } })));
}

const { year, branch } = Astro.props as { year: number; branch: string };
const animalName = BRANCHES[branch].animal;
const slug = ZODIAC_SLUG[branch];
const r = zodiacYearReading(branch, year);
const info = YEAR_INFO[year];
const thisYear = 2026;
// 1936년이 쥐띠(丙子)라서 쥐띠부터 차례로 한 해씩 더함
const born = Array.from({ length: 8 }, (_, i) => 1936 + ZODIAC_BRANCHES.indexOf(branch) + i * 12).filter((y) => y <= thisYear);
const path = `/zodiac/${year}/${slug}/`;
const og = `/og/zodiac/${year}-${slug}.png`;
const relName = r.rel === '평' ? '무난' : r.rel === '같음' ? '같은 띠의 해' : r.rel;
const others = ZODIAC_BRANCHES.filter((b) => b !== branch);
const samjaeKind = r.samjae as keyof typeof SAMJAE_TEXT | null;

const faq = [
  { q: `${animalName}띠는 몇 년생인가요?`, a: `${born.slice(-5).join(', ')}년생이 ${animalName}띠예요. 사주에서는 입춘(2월 4일 무렵)을 기준으로 해가 바뀌어서, 1월이나 2월 초에 태어났다면 앞 띠일 수 있어요.` },
  { q: `${year}년에 ${animalName}띠는 삼재인가요?`, a: r.samjae ? `네, ${year}년은 ${animalName}띠에게 ${r.samjae}예요. ${SAMJAE_TEXT[samjaeKind!]}` : `아니요. ${year}년은 ${animalName}띠의 삼재 해가 아니에요.` },
  { q: '내 생년월일로 더 자세히 볼 수 있나요?', a: '네. 신년운세에 생년월일을 넣으면 내 사주 여덟 글자로 월별 운세와 분야별 운세를 자세히 풀어 드려요.' },
];
---

<Base
  title={`${year}년 ${animalName}띠 운세`}
  description={`${year}년 ${info.name} ${animalName}띠 운세. ${r.total} 재물운, 연애운, 직장운, 건강운과 ${r.samjae ? `${r.samjae}, ` : ''}행운의 색까지 확인하세요.`}
  ogImage={og}
  crumbs={[
    { name: '띠별 운세', path: '/zodiac/' },
    { name: `${year}년 ${animalName}띠`, path },
  ]}
  jsonLd={[faqLd(faq)]}
  back="/zodiac/"
  headerTitle={`${year}년 ${animalName}띠 운세`}
>
  <div class="col pt-2">
    <Talisman
      head={`${year} 띠별 운세`}
      kicker={`${info.animal}의 해, ${animalName}띠는`}
      name={`${r.grade.name}(${r.grade.hanja})`}
      big={`${r.score}점`}
      line={r.total}
      rows={[
        ['올해와의 관계', relName],
        ['행운의 색', r.lucky.color],
        ...(r.samjae ? ([['삼재', r.samjae]] as [string, string][]) : []),
      ]}
      seal={r.grade.hanja}
      chars={[slug, info.char]}
      theme="money"
      mood={r.score >= 70 ? 'happy' : 'normal'}
    />

    <section class="card mt-3" aria-label="공유">
      <ShareBar
        title={`${year}년 ${animalName}띠 운세는 ${r.grade.name}`}
        text={r.total}
        path={path}
        ctaPath="/newyear/"
        ogImage={og}
        campaign="zodiac"
        talisman={{
          head: `${SITE.name} ${year} 띠별 운세`,
          kicker: `${info.animal}의 해, ${animalName}띠는`,
          name: `${r.grade.name}(${r.grade.hanja})`,
          big: `${r.score}점`,
          line: r.total,
          seal: r.grade.hanja,
          foot: siteFoot(Astro.site),
          scene: { chars: [slug, info.char], theme: 'money', mood: r.score >= 70 ? 'happy' : 'normal' },
        }}
      />
    </section>

    <section class="card reading-block mt-3">
      <div class="reading-head"><span class="ico" set:html={iconSvg('zodiac', 28)} /><h2 class="reading-head-t">{animalName}띠는 이런 띠예요</h2></div>
      <p class="reading-text">{r.trait} {born.slice(-5).join(', ')}년생이 {animalName}띠예요.</p>
    </section>

    <section class="card reading-block">
      <div class="reading-head"><span class="ico" set:html={iconSvg('newyear', 28)} /><h2 class="reading-head-t">{year}년 총운</h2></div>
      <div class="reading-text">
        <p>{info.line}</p>
        <p class="mt-2">{r.total}</p>
        {r.samjae && <p class="mt-2">{SAMJAE_TEXT[samjaeKind!]}</p>}
      </div>
    </section>

    <AdSlot name="result-top" />

    {
      (
        [
          ['재물운', 'coin', r.money],
          ['연애운', 'heart', r.love],
          ['직장운', 'briefcase', r.work],
          ['건강운', 'health', r.health],
        ] as const
      ).map(([t, ic, body]) => (
        <section class="card reading-block">
          <div class="reading-head">
            <span class="ico" set:html={iconSvg(ic, 28)} />
            <h2 class="reading-head-t">{t}</h2>
          </div>
          <p class="reading-text">{body}</p>
        </section>
      ))
    }

    <section class="card reading-block">
      <div class="reading-head"><span class="ico" set:html={iconSvg('clover', 28)} /><h2 class="reading-head-t">행운 아이템</h2></div>
      <p class="reading-text">
        행운의 색은 {r.lucky.color}, 숫자는 {r.lucky.number}, 좋은 방향은 {r.lucky.direction}이에요. {animalName}띠의 기운을 살려 주는 {ELEMENTS[r.lucky.element as keyof typeof ELEMENTS].name} 기운의 아이템이에요.
      </p>
    </section>

    <a href="/newyear/" class="btn btn-primary btn-block mt-3">내 생년월일로 더 자세히 보기</a>
    <a href={`/zodiac/${year}/`} class="btn btn-line btn-block mt-2">{year}년 띠별 운세 순위 보기</a>

    <AdSlot name="result-article" />

    <section class="card" aria-labelledby="others">
      <h2 id="others" class="card-title">{year}년 다른 띠 운세</h2>
      <ul class="mt-3 grid grid-cols-4 gap-2 text-center">
        {
          others.map((b) => (
            <li>
              <a href={`/zodiac/${year}/${ZODIAC_SLUG[b]}/`} class="flex flex-col items-center gap-1">
                <span class="block h-12 w-12" set:html={charSvg(ZODIAC_SLUG[b], 'happy')} />
                <span class="text-[13px] font-semibold">{BRANCHES[b].animal}띠</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="card" aria-labelledby="faq">
      <h2 id="faq" class="card-title">자주 묻는 질문</h2>
      <Faq items={faq} />
    </section>

    <Related id="zodiac" />
    <Disclaimer />
  </div>
</Base>

<style>
  .reading-head-t {
    flex: 1;
    font-size: 18px;
    font-weight: 750;
    letter-spacing: -0.03em;
  }
  :global(.col li span.block svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
