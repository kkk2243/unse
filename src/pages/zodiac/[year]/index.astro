---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Related from '../../../components/Related.astro';
import Disclaimer from '../../../components/Disclaimer.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Faq from '../../../components/Faq.astro';
import { charSvg } from '../../../art/characters';
import { YEARS, YEAR_INFO, ZODIAC_BRANCHES, ZODIAC_SLUG } from '../../../data/reading';
import { BRANCHES } from '../../../data/saju';
import { samjaeAnimals, yearPillar } from '../../../lib/saju';
import { zodiacYearReading } from '../../../lib/reading';
import { faqLd } from '../../../lib/seo';

export function getStaticPaths() {
  return YEARS.map((year) => ({ params: { year: String(year) }, props: { year } }));
}

const { year } = Astro.props as { year: number };
const info = YEAR_INFO[year];
const yb = yearPillar(year)[1];
const sj = samjaeAnimals(yb);
const ranked = ZODIAC_BRANCHES.map((b) => ({ b, r: zodiacYearReading(b, year) })).sort((a, z) => z.r.score - a.r.score);
const top = ranked[0];
const sjText = sj.map((x) => `${BRANCHES[x.branch].animal}띠(${x.kind})`).join(', ');

const faq = [
  { q: `${year}년에 운이 가장 좋은 띠는?`, a: `띠와 ${info.name}의 관계로 보면 ${BRANCHES[top.b].animal}띠가 ${top.r.score}점으로 가장 높아요. 띠만 본 큰 흐름이라 생년월일로 보면 사람마다 달라요.` },
  { q: `${year}년 삼재띠는?`, a: `${year}년 삼재띠는 ${sjText}예요.` },
  { q: '순위는 어떻게 정했나요?', a: `태어난 해의 띠와 ${year}년 띠가 육합, 삼합처럼 잘 맞는지, 충이나 원진처럼 부딪히는지를 보고 점수를 매겼어요. 재미로 보는 큰 흐름이에요.` },
];
---

<Base
  title={`${year}년 띠별 운세 순위`}
  description={`${year}년 ${info.name} 띠별 운세 순위. 1등 ${BRANCHES[top.b].animal}띠부터 열두 띠의 점수와 삼재띠(${sjText})를 한눈에 확인하세요.`}
  ogImage="/og/test-zodiac.png"
  crumbs={[
    { name: '띠별 운세', path: '/zodiac/' },
    { name: `${year}년 순위`, path: `/zodiac/${year}/` },
  ]}
  jsonLd={[faqLd(faq)]}
  back="/zodiac/"
  headerTitle={`${year}년 띠별 순위`}
>
  <div class="col pt-2">
    <PageHero
      title={`${year}년 띠별 운세 순위`}
      lead={`${info.animal}의 해 ${info.name}, 열두 띠 중 1등은 ${BRANCHES[top.b].animal}띠예요. 내 띠를 눌러 자세한 풀이를 보세요.`}
      chars={[ZODIAC_SLUG[top.b], info.char]}
      theme="luck"
    />

    <section class="card mt-3" aria-labelledby="rank-h">
      <h2 id="rank-h" class="card-title">{year}년 열두 띠 순위</h2>
      <p class="card-sub">삼재띠는 {sjText}예요.</p>
      <ol class="mt-3 flex flex-col gap-2">
        {
          ranked.map(({ b, r }, i) => (
            <li>
              <a href={`/zodiac/${year}/${ZODIAC_SLUG[b]}/`} class="rrow">
                <span class="rk">{i + 1}</span>
                <span class="zf" set:html={charSvg(ZODIAC_SLUG[b], r.score >= 70 ? 'happy' : 'normal')} />
                <span class="min-w-0 flex-1">
                  <b class="text-[15px]">{BRANCHES[b].animal}띠</b>
                  <span class="ml-1 text-[13px] text-ink-2">
                    {r.grade.name}
                    {r.samjae ? `, ${r.samjae}` : ''}
                  </span>
                  <span class="block truncate text-[13px] text-ink-2">{r.total}</span>
                </span>
                <span class="text-[15px] font-bold">{r.score}점</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <AdSlot name="list-infeed" format="fluid" />

    <a href="/newyear/" class="btn btn-primary btn-block mt-3">내 생년월일로 {year}년 신년운세 보기</a>

    <Faq items={faq} />
    <Related id="zodiac" />
    <Disclaimer />
  </div>
</Base>

<style>
  .rrow {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 16px;
    background: var(--wash);
  }
  .rk {
    width: 22px;
    text-align: center;
    font-weight: 800;
  }
  .zf {
    width: 44px;
    height: 44px;
    flex: none;
  }
  .zf :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
