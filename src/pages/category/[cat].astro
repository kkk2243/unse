---
import Base from '../../layouts/Base.astro';
import TestList from '../../components/TestList.astro';
import AdSlot from '../../components/AdSlot.astro';
import PageHero from '../../components/PageHero.astro';
import { CATEGORIES, type CategoryKey } from '../../config/site';
import { byCategory } from '../../data/catalog';

export function getStaticPaths() {
  return Object.keys(CATEGORIES).map((cat) => ({ params: { cat } }));
}

const key = Astro.params.cat as CategoryKey;
const cat = CATEGORIES[key];
const items = byCategory(key).sort((a, b) => (a.featured ?? 99) - (b.featured ?? 99));
const hero = {
  saju: { chars: ['owl', 'sun'], theme: 'luck' as const },
  love: { chars: ['rabbit', 'tiger'], theme: 'love' as const },
  test: { chars: ['fox', 'cat', 'dog'], theme: 'group' as const },
}[key];
---

<Base
  title={`${cat.name} 모아 보기`}
  description={`${cat.description} ${items.map((i) => i.title).join(', ')}.`}
  crumbs={[{ name: cat.name, path: `/category/${key}/` }]}
>
  <div class="col pt-2">
    <PageHero title={cat.name} lead={cat.description} chars={hero.chars} theme={hero.theme} />
    <section class="card mt-3">
      <TestList items={items} />
    </section>
    <AdSlot name="list-infeed" format="fluid" />
  </div>
</Base>
