---
import InputPage from '../../components/InputPage.astro';
import { YEARS, DEFAULT_YEAR, YEAR_INFO } from '../../data/reading';
import { samjaeAnimals, yearPillar } from '../../lib/saju';
import { BRANCHES } from '../../data/saju';

const info = YEAR_INFO[DEFAULT_YEAR];
const sj = samjaeAnimals(yearPillar(DEFAULT_YEAR)[1]).map((x) => `${BRANCHES[x.branch].animal}띠`);

const faq = [
  { q: '신년운세는 어떻게 계산하나요?', a: `그해를 다스리는 간지(${DEFAULT_YEAR}년은 정미)가 내 사주의 일간에게 어떤 의미인지, 그해의 지지가 내 사주와 합을 이루는지 부딪히는지를 함께 따져요. 열두 달의 월 간지도 하나씩 계산해서 달마다 흐름을 보여드려요.` },
  { q: `${DEFAULT_YEAR}년 삼재띠는 무엇인가요?`, a: `${DEFAULT_YEAR}년 삼재띠는 ${sj.join(', ')}예요. 삼재 3년 중 마지막 해인 날삼재라 비교적 가볍게 지나가는 해로 봐요.` },
  { q: '띠별 운세도 볼 수 있나요?', a: `네. 띠별 운세에서 열두 띠의 ${DEFAULT_YEAR}년 순위와 띠별 풀이를 볼 수 있어요.` },
  { q: '음력 설 전에 태어났으면 띠가 어떻게 되나요?', a: '사주에서는 음력 설이 아니라 입춘(2월 4일 무렵)을 기준으로 해가 바뀌어요. 1~2월 초에 태어났다면 실제 띠가 한 해 앞일 수 있어요.' },
];
---

<InputPage
  id="newyear"
  title={`${DEFAULT_YEAR}년 신년운세`}
  heroTitle={`${DEFAULT_YEAR} 신년운세`}
  lead={`${info.name}, ${info.animal}의 해. 달마다 달라지는 나의 한 해를 미리 살펴보세요.`}
  desc={`생년월일로 보는 무료 ${DEFAULT_YEAR}년 신년운세. ${info.name} ${info.animal}의 해의 총운, 연애운, 결혼운, 재물운, 직장운, 사업운, 건강운, 월별 운세와 삼재를 자세히 풀어 드려요.`}
  articleTitle="신년운세는 이렇게 풀어요"
  article={[
    info.line,
    '사주 연구원의 신년운세는 그해의 간지가 내 사주와 어떻게 만나는지를 봐요. 그해의 천간이 나에게 어떤 십신인지에 따라 한 해의 큰 주제가 정해지고, 그해의 지지가 내 사주와 합을 이루는지 부딪히는지에 따라 변화의 크기가 달라져요.',
    '열두 달 각각의 월 간지도 계산해서 달마다 운의 높낮이를 그래프로 보여드리고, 연애운, 결혼운, 재물운, 직장운, 사업운, 건강운, 학업운, 대인관계운 여덟 가지를 별점과 함께 길게 풀어 드려요. 내 띠가 삼재에 해당하는지도 함께 알려드려요.',
  ]}
  faq={faq}
  kind="year"
  resultPath="/newyear/result/"
  gateLabel="{year}년 신년운세를 풀이하고 있어요"
  gateSteps={['사주 여덟 글자를 세우는 중', '그해의 간지를 비교하는 중', '열두 달의 흐름을 계산하는 중', '분야별 풀이를 정리하는 중']}
  submitLabel="신년운세 보기"
  years={YEARS}
  defaultYear={DEFAULT_YEAR}
  chars={[info.char, 'owl', 'rabbit']}
/>
