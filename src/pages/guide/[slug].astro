---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import GuideBody from '../../components/GuideBody.astro';
import AdSlot from '../../components/AdSlot.astro';
import Related from '../../components/Related.astro';
import { GUIDES, type Guide } from '../../data/guide';
import { SITE } from '../../config/site';

export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: Guide };
const idx = GUIDES.indexOf(g);
const others = GUIDES.filter((x) => x !== g).slice(0, 4);
const half = Math.ceil(g.body.length / 2);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: g.title,
  description: g.desc,
  dateModified: g.updated,
  datePublished: g.updated,
  inLanguage: 'ko-KR',
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name },
  mainEntityOfPage: new URL(`/guide/${g.slug}/`, Astro.site).href,
};
---

<Base title={g.title} description={g.desc} ogImage="/og/guide.png" crumbs={[{ name: '사주 백과', path: '/guide/' }, { name: g.title, path: `/guide/${g.slug}/` }]} jsonLd={[ld]} back="/guide/" headerTitle="사주 백과">
  <div class="col pt-2">
    <PageHero title={g.title} lead={g.desc} chars={g.chars} theme="study" meta={`사주 연구원 사주 백과 ${idx + 1}편`} />
    <article class="card mt-3">
      <GuideBody body={g.body.slice(0, half)} />
    </article>
    <AdSlot name="result-article" />
    <article class="card">
      <GuideBody body={g.body.slice(half)} />
    </article>
    <section class="card">
      <h2 class="card-title">사주 백과 더 읽기</h2>
      <ul class="mt-2 divide-y divide-[var(--line)]">
        {
          others.map((o) => (
            <li>
              <a href={`/guide/${o.slug}/`} class="flex items-center justify-between gap-3 py-3 text-[15.5px] font-semibold">
                {o.title}
                <span class="text-ink-3">›</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/guide/" class="btn btn-line btn-block mt-3">사주 백과 전체 보기</a>
    </section>
    <Related id="saju" title="직접 확인해 보세요" />
  </div>
</Base>
