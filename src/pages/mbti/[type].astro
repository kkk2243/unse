---
import Base from '../../layouts/Base.astro';
import { charSvg, MBTI_CHAR } from '../../art/characters';
import Related from '../../components/Related.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import AdSlot from '../../components/AdSlot.astro';
import ShareBar from '../../components/ShareBar.astro';
import { MBTI, MBTI_CODES, type MbtiCode } from '../../data/mbti/types';
import { mbtiScore, pairSlug, tierOf } from '../../data/mbti/compat';
import { faqLd } from '../../lib/seo';
import { SITE, siteFoot } from '../../config/site';

export function getStaticPaths() {
  return MBTI_CODES.map((c) => ({ params: { type: c.toLowerCase() } }));
}

const code = Astro.params.type.toUpperCase() as MbtiCode;
const m = MBTI[code];
const ranked = MBTI_CODES.map((c) => ({ c, s: mbtiScore(code, c) })).sort((a, b) => b.s - a.s);
const path = `/mbti/${code.toLowerCase()}/`;

const faq = [
  { q: `${code}는 어떤 성격인가요?`, a: `${m.line}. ${m.about[0]}` },
  { q: `${code}는 연애할 때 어떤가요?`, a: m.love },
  { q: `${code}와 가장 잘 맞는 유형은?`, a: `이 사이트의 궁합 기준으로는 ${ranked.filter((r) => r.c !== code).slice(0, 2).map((r) => r.c).join(', ')} 유형과 점수가 가장 높아요.` },
];
---

<Base
  title={`${code} 특징 – ${m.name}`}
  description={`${code} ${m.name}. ${m.line}. ${code}의 성격, 연애, 직장, 친구 관계, 잘 맞는 유형을 정리했어요.`}
  ogImage={`/og/r/mbti-${code.toLowerCase()}.png`}
  crumbs={[
    { name: 'MBTI 16유형 해설', path: '/mbti/' },
    { name: code, path },
  ]}
  jsonLd={[faqLd(faq)]}
>
  <div class="col pt-2">
    <section class="card">
      <div class="flex items-center gap-4">
        <span class="block h-20 w-20 flex-none" set:html={charSvg(MBTI_CHAR[code], 'happy')} />
        <div>
          <h1 class="font-display text-[34px] leading-none font-extrabold">{code}</h1>
          <p class="mt-2 text-[17px] font-semibold">{m.name}</p>
        </div>
      </div>
      <p class="mt-4 text-[16.5px] leading-relaxed">{m.line}</p>
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {m.keys.map((k) => <li class="tag">{k}</li>)}
      </ul>
    </section>

    <article class="card prose-lab">
      <h2>{code}의 성격</h2>
      {m.about.map((p) => <p>{p}</p>)}
      <h2>연애할 때</h2>
      <p>{m.love}</p>
    </article>

    <AdSlot name="result-article" />

    <article class="card prose-lab">
      <h2>일할 때</h2>
      <p>{m.work}</p>
      <h2>친구와 있을 때</h2>
      <p>{m.friend}</p>
      <h2>싸울 때</h2>
      <p>{m.fight}</p>
      <h2>강점과 약점</h2>
      <h3>강점</h3>
      <ul>{m.strengths.map((s) => <li>{s}</li>)}</ul>
      <h3>약점</h3>
      <ul>{m.weaknesses.map((s) => <li>{s}</li>)}</ul>
    </article>

    <section class="card" aria-labelledby="compat">
      <h2 id="compat" class="card-title">{code}와 다른 유형의 궁합</h2>
      <p class="mt-1 text-[14.5px] text-ink-2">점수가 높은 순서예요. 누르면 자세한 궁합을 볼 수 있어요.</p>
      <ol class="rows mt-3">
        {
          ranked.map(({ c, s }) => (
            <li>
              <a href={`/mbti-match/${pairSlug(code, c)}/`} class="row-link !py-3">
                <span class="thumb !h-11 !w-11" set:html={charSvg(MBTI_CHAR[c], c === code ? 'normal' : 'happy')} />
                <span class="flex-1">
                  <span class="row-title block font-semibold">
                    {code} × {c}
                  </span>
                  <span class="block text-[13.5px] text-ink-2">{tierOf(s, c === code).name}</span>
                </span>
                <span class="font-display text-[19px] font-extrabold">{s}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="card" aria-label="공유">
      <ShareBar
        title={`${code} ${m.name}`}
        text={m.line}
        path={path}
        ctaPath="/test/mbti/"
        ogImage={`/og/r/mbti-${code.toLowerCase()}.png`}
        campaign="mbti-type"
        talisman={{
          head: `${SITE.name} 성격 유형`,
          kicker: '나의 성격 유형은',
          name: code,
          line: `${m.name}. ${m.line}`,
          keys: m.keys,
          seal: code,
          foot: siteFoot(Astro.site),
          scene: { chars: [MBTI_CHAR[code]], theme: 'work', mood: 'happy' },
        }}
      />
    </section>

    <a href="/test/mbti/" class="btn btn-primary btn-block mt-3">내 유형 검사하기</a>
    <Related id="mbti-types" />
    <Disclaimer mbti />
  </div>
</Base>
