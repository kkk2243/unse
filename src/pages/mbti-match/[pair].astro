---
import Base from '../../layouts/Base.astro';
import Talisman from '../../components/Talisman.astro';
import ShareBar from '../../components/ShareBar.astro';
import Related from '../../components/Related.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import AdSlot from '../../components/AdSlot.astro';
import { MBTI, MBTI_CODES, type MbtiCode } from '../../data/mbti/types';
import { matchDetail, pairSlug, canonicalPair, mbtiScore } from '../../data/mbti/compat';
import { SITE, siteFoot } from '../../config/site';
import { MBTI_CHAR, charSvg } from '../../art/characters';

export function getStaticPaths() {
  return MBTI_CODES.flatMap((a) => MBTI_CODES.map((b) => ({ params: { pair: pairSlug(a, b) }, props: { a, b } })));
}

const { a, b } = Astro.props as { a: MbtiCode; b: MbtiCode };
const d = matchDetail(a, b);
const same = a === b;
const canon = canonicalPair(a, b);
const path = `/mbti-match/${pairSlug(a, b)}/`;
const og = `/og/m/${canon}.png`;
const big = same ? '' : `${d.score}점`;
const title = `${a} ${b} 궁합 – ${d.tier.name}${same ? '' : ` ${d.score}점`}`;
const desc = `${a}(${MBTI[a].name})와 ${b}(${MBTI[b].name})의 MBTI 궁합. ${d.tier.line}. 대화, 감정 표현, 생활 리듬, 싸울 때 모습까지 정리했어요.`;

const othersOf = (x: MbtiCode, except: MbtiCode) =>
  MBTI_CODES.filter((c) => c !== except)
    .map((c) => ({ c, s: mbtiScore(x, c) }))
    .sort((p, q) => q.s - p.s)
    .slice(0, 5);
---

<Base
  title={title}
  description={desc}
  ogImage={og}
  canonicalPath={`/mbti-match/${canon}/`}
  crumbs={[
    { name: 'MBTI 궁합', path: '/mbti-match/' },
    { name: `${a} × ${b}`, path },
  ]}
>
  <div class="col pt-2">
    <Talisman
      head="MBTI 궁합 판정"
      kicker={`${a} × ${b}`}
      name={d.tier.name}
      big={big}
      line={d.tier.line}
      seal={d.tier.seal}
      chars={same ? [MBTI_CHAR[a]] : [MBTI_CHAR[a], MBTI_CHAR[b]]}
      theme="love"
      mood={d.score >= 70 || same ? 'happy' : 'normal'}
    />

    <section class="card mt-3" aria-label="공유">
      <ShareBar
        title={`${a} × ${b} 궁합은 ${same ? '거울 궁합' : `${d.score}점`}!`}
        text={`${d.tier.name}. ${d.tier.line}`}
        path={path}
        ctaPath="/mbti-match/"
        ogImage={og}
        campaign="mbti-match"
        talisman={{
          head: `${SITE.name} MBTI 궁합 판정`,
          kicker: `${a} × ${b}`,
          name: d.tier.name,
          big: big || undefined,
          line: d.tier.line,
          seal: d.tier.seal,
          foot: siteFoot(Astro.site),
          scene: { chars: same ? [MBTI_CHAR[a]] : [MBTI_CHAR[a], MBTI_CHAR[b]], theme: 'love', mood: d.score >= 70 || same ? 'happy' : 'normal' },
        }}
      />
    </section>

    <section class="card" aria-labelledby="glance">
      <h2 id="glance" class="card-title">한눈에 보기</h2>
      <ul class="mt-4 space-y-3">
        {
          d.bars.map((bar) => (
            <li class="grid grid-cols-[92px_1fr_36px] items-center gap-3 text-[14.5px]">
              <span class="font-semibold text-ink-2">{bar.label}</span>
              <span class="bar" style="--bar-c:var(--jusa)">
                <i style={`width:${bar.value}%`} />
              </span>
              <span class="text-right font-display font-extrabold">{bar.value}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="mt-3 grid grid-cols-2 gap-3">
      {
        [a, b].map((c) => (
          <a href={`/mbti/${c.toLowerCase()}/`} class="card !mt-0 block !p-4">
            <span class="block h-14 w-14" set:html={charSvg(MBTI_CHAR[c], 'happy')} />
            <span class="mt-3 block font-display text-[18px] font-extrabold">{c}</span>
            <span class="mt-0.5 block text-[13.5px] leading-snug text-ink-2">{MBTI[c].name}</span>
          </a>
        ))
      }
    </div>

    <article class="card prose-lab mt-3">
      {
        d.sections.slice(0, 2).map((s) => (
          <>
            <h2>{s.title}</h2>
            <p>{s.body}</p>
          </>
        ))
      }
    </article>

    <AdSlot name="result-article" />

    <article class="card prose-lab">
      {
        d.sections.slice(2).map((s) => (
          <>
            <h2>{s.title}</h2>
            <p>{s.body}</p>
          </>
        ))
      }
      <h2>싸울 때는</h2>
      {
        same ? (
          <p>
            둘 다 {a}라서 싸우는 방식도 똑같아요. {d.fight.a} 그래서 서로의 다음 행동이 너무 잘 보이는 게 함정이에요.
          </p>
        ) : (
          <ul>
            <li>
              <strong>{a}</strong>: {d.fight.a}
            </li>
            <li>
              <strong>{b}</strong>: {d.fight.b}
            </li>
          </ul>
        )
      }
      <p>{d.fight.tip}</p>
    </article>

    <a href="/love/name-mbti/" class="btn btn-line btn-block mt-3">이름까지 넣어서 궁합 보기</a>

    <section class="card mt-3" aria-labelledby="more">
      <h2 id="more" class="card-title">다른 조합도 보기</h2>
      <div class="mt-4 grid grid-cols-2 gap-6">
        {
          [a, b]
            .filter((x, i, arr) => arr.indexOf(x) === i)
            .map((x) => (
              <div>
                <p class="text-[14px] font-bold text-ink-2">{x}와 잘 맞는</p>
                <ul class="mt-2 space-y-1">
                  {othersOf(x, x).map(({ c, s }) => (
                    <li>
                      <a href={`/mbti-match/${pairSlug(x, c)}/`} class="flex justify-between py-1 text-[15px] hover:underline">
                        <span class="font-semibold">
                          {x} × {c}
                        </span>
                        <span class="font-display font-extrabold text-jusa">{s}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
        }
      </div>
      <a href="/mbti-match/" class="mt-6 inline-block text-[15px] font-semibold underline underline-offset-4">전체 궁합표 보기</a>
    </section>

    <Related id="mbti-match" />
    <Disclaimer mbti />
  </div>
</Base>
