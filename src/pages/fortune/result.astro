---
import Base from '../../layouts/Base.astro';
import ResultShell from '../../components/ResultShell.astro';
import WeekStamps from '../../components/WeekStamps.astro';
---

<Base title="운세 결과" noindex back="/fortune/today/" headerTitle="운세 결과">
  <ResultShell
    id="fortune-today"
    inputPath="/fortune/today/"
    inputLabel="오늘의 운세 보러 가기"
    head="오늘의 부적"
    seal="今日"
    chars={['owl']}
    theme="luck"
    shareCampaign="fortune-day"
  />
  <template id="stamps-tpl"><WeekStamps size="md" /></template>
</Base>

<script>
  import { getPending, currentProfile, honor } from '../../lib/profile';
  import { calcSaju } from '../../lib/saju';
  import { dayReading } from '../../lib/reading';
  import { fillTalisman, replayReveal } from '../../lib/talisman-dom';
  import { updateShare } from '../../lib/share';
  import { block, paras, catSummary, catBlocks, luckyHtml, listHtml, keywordsHtml } from '../../lib/render';
  import { markToday, streak } from '../../lib/attendance';
  import { todayKST, toast, track, escapeHtml as e } from '../../lib/ui';
  import { ZODIAC_SLUG } from '../../data/reading';
  import { BRANCHES, ELEMENTS } from '../../data/saju';

  const today = todayKST();
  const shift = (ymd: string, n: number) => {
    const [y, m, d] = ymd.split('-').map(Number);
    return new Date(Date.UTC(y, m - 1, d + n)).toISOString().slice(0, 10);
  };
  const mode = new URLSearchParams(location.search).get('m') ?? 'today';
  let pend = getPending('day');
  if (!pend) {
    const cp = currentProfile();
    if (cp) pend = { kind: 'day', a: cp, date: mode === 'tomorrow' ? shift(today, 1) : today };
  }
  const s = pend ? calcSaju(pend.a) : null;
  if (!pend || !s || typeof s === 'string') {
    document.getElementById('r-empty')!.hidden = false;
  } else {
    const date = pend.date!;
    const kind = date === today ? 'today' : date === shift(today, 1) ? 'tomorrow' : 'date';
    const r = dayReading(s, date, kind, pend.a.name);
    const [y, m, d] = date.split('-').map(Number);
    const week = ['일', '월', '화', '수', '목', '금', '토'][new Date(Date.UTC(y, m - 1, d)).getUTCDay()];
    const when = kind === 'today' ? '오늘' : kind === 'tomorrow' ? '내일' : `${m}월 ${d}일`;
    const name = honor(pend.a.name);
    const animal = ZODIAC_SLUG[s.yearBranch];
    const best = [...r.cats].sort((a, b) => b.stars - a.stars)[0];
    const theme = ({ love: 'love', marriage: 'love', money: 'money', business: 'money', work: 'work', study: 'study', health: 'study', people: 'group' } as const)[best.key];
    document.title = `${when}의 운세 | 사주 연구원`;

    const card = {
      kicker: `${name}의 ${m}월 ${d}일 ${week}요일`,
      name: r.headline,
      big: `${r.score}점`,
      line: (r.total[0].match(/^[^.]+\./) ?? [r.advice])[0].replace(/^(오늘|내일|이날)은 /, ''),
      rows: [
        ['가장 좋은 운', `${best.name} ${'★'.repeat(best.stars)}`],
        ['행운의 색', r.lucky.color],
        ['행운의 숫자', r.lucky.number],
      ] as [string, string][],
      seal: kind === 'today' ? '今日' : kind === 'tomorrow' ? '來日' : '擇日',
      scene: { chars: [animal], theme, mood: r.tone === 'bad' ? ('normal' as const) : ('happy' as const) },
    };
    const cardEl = document.getElementById('r-card')!;
    fillTalisman(cardEl, card);
    document.getElementById('r-body')!.hidden = false;
    replayReveal(cardEl);

    const timeHtml = `<ul class="space-y-3">${r.times
      .map(
        (t) => `<li class="flex items-start gap-3"><span class="tag ${t.good ? '' : 'tag-red'}" style="min-width:44px;text-align:center">${t.label}</span>
        <span class="flex-1 text-[15.5px]"><span class="text-ink-3 text-[13px]">${t.range}</span><br>${e(t.text)}</span></li>`,
      )
      .join('')}</ul>`;

    const sections = [
      block(`${when}의 총운`, `<div class="score-ring"><span class="font-display text-[40px] font-extrabold text-jusa">${r.score}</span><span class="font-bold">점</span></div>${paras(r.total)}`, 'today'),
      block(`${when}의 키워드`, keywordsHtml(r.keywords) + listHtml(`${when} 하면 좋은 일`, r.dos) + listHtml(`${when} 피하면 좋은 일`, r.donts, true), 'clover'),
      catSummary(r.cats),
      block('시간대별 흐름', timeHtml, 'clock'),
      catBlocks(r.cats),
      block(
        '행운 아이템',
        luckyHtml(r.lucky) +
          `<p class="mt-3 text-[14px] text-ink-2">${e(name)}에게 도움이 되는 ${ELEMENTS[r.lucky.element].name}(${ELEMENTS[r.lucky.element].hanja})의 기운을 채워 주는 것들이에요.</p>`,
        'clover',
      ),
      block('연구원의 한마디', `<p>${e(r.advice)}</p>`, 'saju'),
    ];
    document.getElementById('r-sections')!.innerHTML = sections.join('');

    if (kind === 'today') {
      const tpl = document.getElementById('stamps-tpl') as HTMLTemplateElement;
      const wrap = document.createElement('section');
      wrap.className = 'card';
      wrap.innerHTML = `<h3 class="card-title">이번 주 출석 도장</h3><div class="mt-4"></div>`;
      wrap.querySelector('div')!.appendChild(tpl.content.cloneNode(true));
      document.getElementById('r-after')!.appendChild(wrap);
      const isNew = markToday();
      document.dispatchEvent(new Event('attendance:change'));
      const st = streak();
      if (isNew) toast(st === 7 ? '7일 연속 출석 달성!' : st > 1 ? `출석 도장 쾅. ${st}일째예요` : '첫 출석 도장 쾅');
    }

    const more = document.createElement('div');
    more.className = 'grid grid-cols-2 gap-2';
    more.innerHTML = `<a href="/zodiac/today/" class="btn btn-line btn-sm">오늘의 띠별 순위</a><a href="/dream/" class="btn btn-line btn-sm">어젯밤 꿈 해몽</a>`;
    document.getElementById('r-after')!.appendChild(more);
    const share = document.getElementById('r-share')!;
    updateShare(share, {
      title: `${when} 내 운세 ${r.score}점, ${r.headline}`,
      text: `${BRANCHES[s.yearBranch].animal}띠 ${name}의 ${when} 운세. 생일만 넣으면 나도 볼 수 있어요`,
      image: new URL(`/og/day/${animal}.png`, location.origin).href,
      talisman: { ...card, head: cardEl.querySelector('.t-head')!.textContent!, foot: cardEl.querySelector('.t-foot')!.textContent! },
    });
    track('test_complete', { test: `fortune-${kind}`, result: String(r.score) });
  }
</script>
