---
import Base from '../layouts/Base.astro';
import ProfileForm from '../components/ProfileForm.astro';
import InviteBox from '../components/InviteBox.astro';
import { charSvg } from '../art/characters';
import { iconSvg } from '../art/icons';
import { DEFAULT_YEAR } from '../data/reading';

const quick = [
  { href: '/fortune/result/?m=today', icon: 'today', label: '오늘의 운세' },
  { href: `/newyear/result/?year=${DEFAULT_YEAR}`, icon: 'newyear', label: `${DEFAULT_YEAR} 신년운세` },
  { href: '/saju/result/', icon: 'saju', label: '정통 사주' },
];
---

<Base title="내 정보" description="저장한 생년월일로 운세를 바로 볼 수 있어요. 정보는 이 기기에만 저장돼요." noindex headerTitle="내 정보">
  <div class="col pt-2">
    <section class="card text-center" id="me-card">
      <span class="mx-auto block h-24 w-24" set:html={charSvg('owl', 'happy')} />
      <p class="mt-2 text-[20px] font-extrabold" id="me-name">반가워요</p>
      <p class="text-[14.5px] text-ink-2" id="me-sub">생년월일을 저장하면 운세를 바로 볼 수 있어요</p>
      <ul class="mt-4 grid grid-cols-3 gap-2" id="me-quick" hidden>
        {
          quick.map((q) => (
            <li>
              <a href={q.href} class="flex flex-col items-center gap-1 rounded-[14px] bg-[var(--wash)] px-1 py-3 text-[13.5px] font-semibold">
                <span set:html={iconSvg(q.icon, 32)} />
                {q.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="card" aria-labelledby="list-title">
      <h2 id="list-title" class="card-title">저장된 사람</h2>
      <p class="card-sub">가족, 친구 정보도 저장해 두면 운세를 고를 때 바로 쓸 수 있어요. 최대 6명.</p>
      <ul class="rows mt-3" id="me-list"></ul>
      <p class="mt-3 text-[14.5px] text-ink-3" id="me-empty">아직 저장한 사람이 없어요.</p>
    </section>

    <form class="card" id="me-form" novalidate>
      <h2 class="card-title">사람 추가하기</h2>
      <div class="mt-4"><ProfileForm prefix="pn" save={false} /></div>
      <p class="mt-3 min-h-[20px] text-[13.5px] font-semibold text-jusa" id="me-error" role="alert"></p>
      <button type="submit" class="btn btn-primary btn-block mt-1">이 기기에 저장</button>
    </form>

    <InviteBox />

    <section class="card">
      <h2 class="card-title">정보는 이렇게 다뤄요</h2>
      <p class="mt-2 text-[15px] leading-relaxed text-ink-2">
        저장한 이름과 생년월일은 지금 쓰는 브라우저 안에만 보관하고 서버로 보내지 않아요. 브라우저 기록을 지우거나 아래 버튼을 누르면 모두 사라져요.
      </p>
      <button type="button" class="btn btn-line btn-block mt-4" id="me-clear">저장한 정보 모두 지우기</button>
    </section>
  </div>
</Base>

<script>
  import { profiles, currentProfile, saveProfile, setCurrent, removeProfile, clearProfiles, birthLabel, honor } from '../lib/profile';
  import { readProfileForm } from '../lib/profile-form';
  import { calcSaju } from '../lib/saju';
  import { BRANCHES } from '../data/saju';
  import { charSvg } from '../art/characters';
  import { ZODIAC_SLUG } from '../data/reading';
  import { toast, escapeHtml as e } from '../lib/ui';

  const list = document.getElementById('me-list')!;
  const empty = document.getElementById('me-empty')!;
  const TIMES = ['자시', '축시', '인시', '묘시', '진시', '사시', '오시', '미시', '신시', '유시', '술시', '해시'];

  function paint() {
    const ps = profiles();
    const cur = currentProfile();
    empty.hidden = ps.length > 0;
    document.getElementById('me-quick')!.hidden = !cur;
    if (cur) {
      document.getElementById('me-name')!.textContent = `${honor(cur.name)}, 반가워요`;
      document.getElementById('me-sub')!.textContent = '지금 선택된 사람으로 운세를 바로 볼 수 있어요';
    } else {
      document.getElementById('me-name')!.textContent = '반가워요';
      document.getElementById('me-sub')!.textContent = '생년월일을 저장하면 운세를 바로 볼 수 있어요';
    }
    list.innerHTML = ps
      .map((p) => {
        const s = calcSaju(p);
        const zb = typeof s === 'string' ? '' : s.yearBranch;
        const on = cur?.id === p.id;
        return `<li class="flex items-center gap-3 py-3">
          <span class="thumb">${zb ? charSvg(ZODIAC_SLUG[zb], on ? 'happy' : 'normal') : ''}</span>
          <span class="min-w-0 flex-1"><span class="block font-bold">${e(p.name)} ${on ? '<span class="tag">선택됨</span>' : ''}</span>
          <span class="block text-[13.5px] text-ink-2">${birthLabel(p)}, ${p.gender === 'M' ? '남' : '여'}, ${p.t >= 0 ? TIMES[p.t] : '시간 모름'}${zb ? `, ${BRANCHES[zb].animal}띠` : ''}</span></span>
          ${on ? '' : `<button type="button" class="chip" data-pick="${p.id}">선택</button>`}
          <button type="button" class="chip" data-del="${p.id}" aria-label="${e(p.name)} 지우기">지우기</button>
        </li>`;
      })
      .join('');
  }
  paint();

  list.addEventListener('click', (ev) => {
    const t = ev.target as HTMLElement;
    const pick = t.closest<HTMLElement>('[data-pick]')?.dataset.pick;
    const del = t.closest<HTMLElement>('[data-del]')?.dataset.del;
    if (pick) {
      setCurrent(pick);
      toast('선택했어요');
    }
    if (del) {
      removeProfile(del);
      toast('지웠어요');
    }
    paint();
  });

  const form = document.getElementById('me-form') as HTMLFormElement;
  form.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const p = readProfileForm(form, 'pn');
    if (typeof p === 'string') return void (document.getElementById('me-error')!.textContent = p);
    document.getElementById('me-error')!.textContent = '';
    const { save: _s, ...rest } = p;
    saveProfile(rest, profiles().length === 0);
    form.reset();
    toast('저장했어요');
    paint();
  });

  document.getElementById('me-clear')!.addEventListener('click', () => {
    clearProfiles();
    toast('모두 지웠어요');
    paint();
  });
</script>
