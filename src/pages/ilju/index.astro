---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import AdSlot from '../../components/AdSlot.astro';
import Faq from '../../components/Faq.astro';
import Related from '../../components/Related.astro';
import { ILJU_LIST, iljuInfo, STEM_ORDER } from '../../lib/ilju';
import { STEMS, DAY_MASTER, ELEMENTS } from '../../data/saju';
import { charSvg } from '../../art/characters';
import { faqLd } from '../../lib/seo';

const groups = STEM_ORDER.map((s) => ({ stem: s, items: ILJU_LIST.filter((g) => g[0] === s).map(iljuInfo) }));
const faq = [
  { q: '일주가 뭐예요?', a: '일주는 태어난 날의 기둥이에요. 위 글자(일간)는 겉으로 드러나는 나, 아래 글자(일지)는 속마음과 배우자 자리를 뜻해서 사주에서 나를 가장 잘 보여 줘요.' },
  { q: '"흰 용 일주"는 무슨 뜻인가요?', a: '천간의 색(갑을 푸른, 병정 붉은, 무기 노란, 경신 흰, 임계 검은)과 지지의 띠 동물을 합친 별명이에요. 해마다 "붉은 말의 해"라고 부르는 것과 같은 방식이에요.' },
  { q: '음력 생일로도 찾을 수 있나요?', a: '네. 음력에 체크하고 날짜를 넣으면 양력으로 바꿔서 일주를 찾아 드려요. 윤달이면 윤달에도 체크해 주세요.' },
];
---

<Base
  title="60갑자 일주 도감, 내 일주 찾기"
  description="갑자일주부터 계해일주까지 60가지 일주의 성격, 연애, 직업, 잘 맞는 일주를 정리한 일주 도감. 생년월일만 넣으면 내 일주와 '흰 용', '붉은 말' 같은 일주 별명을 알려 드려요."
  ogImage="/og/test-ilju.png"
  crumbs={[{ name: '일주 도감', path: '/ilju/' }]}
  jsonLd={[faqLd(faq)]}
  back="/"
  headerTitle="일주 도감"
>
  <div class="col pt-2">
    <PageHero title="60갑자 일주 도감" lead="태어난 날 하나로 알아보는 나의 일주. 흰 용, 붉은 말처럼 나만의 별명도 생겨요." chars={['dragon', 'rock', 'horse']} theme="study" />

    <form class="card mt-3" id="find-form" novalidate>
      <h2 class="card-title">내 일주 찾기</h2>
      <p class="card-sub" id="find-saved" hidden></p>
      <label class="field-label mt-4" for="find-date">생년월일</label>
      <input class="field" type="date" id="find-date" min="1930-01-01" max="2030-12-31" required />
      <div class="mt-3 flex flex-wrap gap-4 text-[15px]">
        <label class="flex items-center gap-2"><input type="checkbox" id="find-lunar" class="h-5 w-5 accent-[var(--jusa)]" />음력</label>
        <label class="flex items-center gap-2"><input type="checkbox" id="find-leap" class="h-5 w-5 accent-[var(--jusa)]" />윤달</label>
      </div>
      <p class="mt-2 min-h-[20px] text-[13.5px] font-semibold text-jusa" id="find-error" role="alert"></p>
      <button class="btn btn-primary btn-block" type="submit">내 일주 보기</button>
    </form>

    <AdSlot name="list-infeed" format="fluid" />

    {
      groups.map((g) => (
        <section class="card">
          <h2 class="card-title">
            {STEMS[g.stem].ko}({g.stem}) 일주
            <span class="ml-1 text-[14px] font-semibold text-ink-2">{DAY_MASTER[g.stem].image}, {ELEMENTS[STEMS[g.stem].el].name}</span>
          </h2>
          <ul class="mt-3 grid grid-cols-3 gap-2">
            {g.items.map((x) => (
              <li>
                <a href={`/ilju/${x.slug}/`} class="ilju-tile">
                  <span class="block h-12 w-12" set:html={charSvg(x.animalSlug, 'happy')} />
                  <b>{x.ko}일주</b>
                  <span>{x.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="card">
      <h2 class="card-title">자주 묻는 질문</h2>
      <Faq items={faq} />
    </section>
    <a href="/guide/ilju/" class="btn btn-line btn-block">일주가 뭔지 더 알아보기</a>
    <Related id="ilju" />
  </div>
</Base>

<style>
  .ilju-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px 4px 12px;
    border-radius: 16px;
    background: var(--wash);
    text-align: center;
  }
  .ilju-tile b {
    margin-top: 4px;
    font-size: 14.5px;
  }
  .ilju-tile span:last-child {
    font-size: 12.5px;
    color: var(--ink-2);
  }
</style>

<script>
  import { calcSaju } from '../../lib/saju';
  import { iljuSlug, iljuKo, iljuName } from '../../lib/ilju';
  import { currentProfile, honor } from '../../lib/profile';

  const form = document.getElementById('find-form') as HTMLFormElement;
  const date = document.getElementById('find-date') as HTMLInputElement;
  const err = document.getElementById('find-error')!;
  const cp = currentProfile();
  if (cp) {
    const s = calcSaju(cp);
    if (typeof s !== 'string') {
      const gz = s.dayStem + s.dayBranch;
      const el = document.getElementById('find-saved')!;
      el.hidden = false;
      el.innerHTML = `${honor(cp.name)}의 일주는 <a class="font-bold text-jusa underline" href="/ilju/${iljuSlug(gz)}/">${iljuKo(gz)}일주(${iljuName(gz)})</a>예요. 다른 날짜도 찾아볼 수 있어요.`;
    }
  }
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!date.value) return void (err.textContent = '생년월일을 넣어 주세요');
    const [y, m, d] = date.value.split('-').map(Number);
    const lunar = (document.getElementById('find-lunar') as HTMLInputElement).checked;
    const leap = (document.getElementById('find-leap') as HTMLInputElement).checked;
    const s = calcSaju({ y, m, d, cal: lunar ? 'lunar' : 'solar', leap: lunar && leap, t: -1 });
    if (typeof s === 'string') return void (err.textContent = s);
    location.href = `/ilju/${iljuSlug(s.dayStem + s.dayBranch)}/`;
  });
</script>
