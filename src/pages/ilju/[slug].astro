---
import Base from '../../layouts/Base.astro';
import Talisman from '../../components/Talisman.astro';
import ShareBar from '../../components/ShareBar.astro';
import AdSlot from '../../components/AdSlot.astro';
import Faq from '../../components/Faq.astro';
import Related from '../../components/Related.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { ILJU_LIST, iljuInfo, iljuSlug, type IljuInfo } from '../../lib/ilju';
import { DAY_MASTER_CHAR, charSvg } from '../../art/characters';
import { iconSvg } from '../../art/icons';
import { faqLd } from '../../lib/seo';

export function getStaticPaths() {
  return ILJU_LIST.map((gz) => ({ params: { slug: iljuSlug(gz) }, props: { x: iljuInfo(gz) } }));
}
const { x } = Astro.props as { x: IljuInfo };
const i = ILJU_LIST.indexOf(x.gz);
const prev = iljuInfo(ILJU_LIST[(i + 59) % 60]);
const next = iljuInfo(ILJU_LIST[(i + 1) % 60]);
const path = `/ilju/${x.slug}/`;
const ICON: Record<string, string> = { me: 'me', inner: 'saju', flag: 'zodiac', love: 'heart', work: 'briefcase', money: 'coin', people: 'group' };
const faq = [
  { q: `${x.ko}일주는 어떤 성격인가요?`, a: `${x.ko}일주는 ${x.picture}이에요. ${x.dm.line}으로, ${x.plus.join(', ')}는 장점이 있어요.` },
  { q: `${x.ko}일주와 잘 맞는 일주는?`, a: `천간과 지지가 모두 합을 이루는 ${x.best.ko}일주(${x.best.name})와 서로 끌리는 인연으로 봐요. 반대로 ${x.clash.ko}일주(${x.clash.name})와는 기운이 정면으로 부딪히기 쉬워요.` },
  { q: '내 일주는 어떻게 알 수 있나요?', a: '일주는 태어난 날로 정해져요. 사주 연구원의 정통 사주 풀이나 일주 도감 첫 화면에서 생년월일을 넣으면 바로 확인할 수 있어요.' },
];
---

<Base
  title={`${x.ko}일주 특징, ${x.name} 일주의 성격과 연애`}
  description={`${x.ko}일주(${x.gz}, ${x.name})의 성격, 속마음, 연애와 결혼, 직업, 재물운, 잘 맞는 일주를 정리했어요. ${x.dm.line}.`}
  ogImage={`/og/ilju/${x.slug}.png`}
  crumbs={[{ name: '일주 도감', path: '/ilju/' }, { name: `${x.ko}일주`, path }]}
  jsonLd={[faqLd(faq)]}
  back="/ilju/"
  headerTitle="일주 도감"
>
  <div class="col pt-2">
    <Talisman
      head="일주 도감"
      kicker={`${x.ko}일주(${x.gz})`}
      name={`${x.name} 일주`}
      line={x.dm.line}
      keys={x.keys}
      seal={x.gz}
      chars={[DAY_MASTER_CHAR[x.stem], x.animalSlug]}
      theme="study"
    />

    <section class="card mt-3" aria-label="공유">
      <ShareBar
        title={`나는 ${x.ko}일주, ${x.name}래`}
        text={x.dm.line}
        path={path}
        ctaPath="/ilju/"
        ogImage={`/og/ilju/${x.slug}.png`}
        campaign="ilju"
        talisman={{ head: '사주 연구원 일주 도감', kicker: `${x.ko}일주(${x.gz})`, name: `${x.name} 일주`, line: x.dm.line, keys: x.keys, seal: x.gz, foot: '사주 연구원', scene: { chars: [DAY_MASTER_CHAR[x.stem], x.animalSlug], theme: 'study' } }}
      />
    </section>

    <section class="card reading-block">
      <div class="reading-head"><span class="ico" set:html={iconSvg('types', 28)} /><h2 class="flex-1">한눈에 보기</h2></div>
      <div class="reading-text">
        <h3 class="text-[14px] font-bold text-ink-2">이런 점이 강해요</h3>
        <ul class="mt-2 space-y-1.5">{x.plus.map((p) => <li class="flex gap-2 text-[15px]"><span class="mt-[9px] h-1.5 w-1.5 flex-none rounded-full bg-[var(--ink-3)]" />{p}</li>)}</ul>
        <h3 class="mt-4 text-[14px] font-bold text-jusa">이런 점은 챙겨 주세요</h3>
        <ul class="mt-2 space-y-1.5">{x.minus.map((p) => <li class="flex gap-2 text-[15px]"><span class="mt-[9px] h-1.5 w-1.5 flex-none rounded-full bg-[var(--jusa)]" />{p}</li>)}</ul>
      </div>
    </section>

    {
      x.sections.slice(0, 3).map((s) => (
        <section class="card reading-block">
          <div class="reading-head"><span class="ico" set:html={iconSvg(ICON[s.key], 28)} /><h2 class="flex-1">{s.title}</h2></div>
          <div class="reading-text">{s.paras.map((p) => <p class="mt-2 first:mt-0">{p}</p>)}</div>
        </section>
      ))
    }

    <AdSlot name="result-article" />

    {
      x.sections.slice(3).map((s) => (
        <section class="card reading-block">
          <div class="reading-head"><span class="ico" set:html={iconSvg(ICON[s.key], 28)} /><h2 class="flex-1">{s.title}</h2></div>
          <div class="reading-text">{s.paras.map((p) => <p class="mt-2 first:mt-0">{p}</p>)}</div>
        </section>
      ))
    }

    <section class="card reading-block">
      <div class="reading-head"><span class="ico" set:html={iconSvg('gunghap', 28)} /><h2 class="flex-1">일주 궁합</h2></div>
      <div class="mt-3 grid grid-cols-2 gap-2">
        <a href={`/ilju/${x.best.slug}/`} class="ilju-mate">
          <span class="tag">찰떡 일주</span>
          <span class="mx-auto mt-2 block h-14 w-14" set:html={charSvg(iljuInfo(x.best.gz).animalSlug, 'happy')} />
          <b>{x.best.ko}일주</b><span>{x.best.name}</span>
        </a>
        <a href={`/ilju/${x.clash.slug}/`} class="ilju-mate">
          <span class="tag tag-red">부딪히는 일주</span>
          <span class="mx-auto mt-2 block h-14 w-14" set:html={charSvg(iljuInfo(x.clash.gz).animalSlug, 'normal')} />
          <b>{x.clash.ko}일주</b><span>{x.clash.name}</span>
        </a>
      </div>
      <p class="mt-3 text-[14.5px] text-ink-2">찰떡 일주는 천간과 지지가 모두 합을 이루는 짝이에요. 부딪히는 일주는 기운이 정면으로 만나 다툼도 많지만 서로를 크게 자극하는 짝이에요.</p>
      <a href="/gunghap/" class="btn btn-line btn-block mt-3">생년월일로 정확한 궁합 보기</a>
    </section>

    <section class="card">
      <h2 class="card-title">자주 묻는 질문</h2>
      <Faq items={faq} />
    </section>

    <div class="grid grid-cols-2 gap-2">
      <a href={`/ilju/${prev.slug}/`} class="btn btn-line btn-sm">‹ {prev.ko}일주</a>
      <a href={`/ilju/${next.slug}/`} class="btn btn-line btn-sm">{next.ko}일주 ›</a>
    </div>
    <a href="/saju/" class="btn btn-hwang btn-block mt-3">내 사주 전체 풀이 보기</a>
    <a href="/ilju/" class="btn btn-line btn-block mt-2">60갑자 일주 도감 전체 보기</a>

    <Related id="ilju" />
    <Disclaimer />
  </div>
</Base>

<style>
  .ilju-mate {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 14px 8px;
    border-radius: 16px;
    background: var(--wash);
  }
  .ilju-mate b {
    margin-top: 6px;
    font-size: 16px;
  }
  .ilju-mate span:last-child {
    font-size: 13.5px;
    color: var(--ink-2);
  }
</style>
