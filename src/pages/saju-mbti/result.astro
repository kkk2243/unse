---
import Base from '../../layouts/Base.astro';
import ResultShell from '../../components/ResultShell.astro';
---

<Base title="사주 MBTI 결과" noindex back="/saju-mbti/" headerTitle="사주 MBTI">
  <ResultShell id="saju-mbti" inputPath="/saju-mbti/" inputLabel="사주 MBTI 보러 가기" head="사주 MBTI 판정" seal="合" chars={['fox']} theme="work" shareCampaign="saju-mbti" />
</Base>

<script>
  import { getPending, honor } from '../../lib/profile';
  import { calcSaju } from '../../lib/saju';
  import { sajuMbti } from '../../lib/saju-mbti';
  import { fillTalisman, replayReveal } from '../../lib/talisman-dom';
  import { updateShare } from '../../lib/share';
  import { block, paras, listHtml } from '../../lib/render';
  import { track, escapeHtml as e } from '../../lib/ui';
  import { MBTI, MBTI_CODES, isMbti } from '../../data/mbti/types';
  import { mbtiScore } from '../../data/mbti/compat';
  import { MBTI_CHAR } from '../../art/characters';
  import { DAY_MASTER } from '../../data/saju';

  const pend = getPending('sm');
  const code = pend?.extra?.mbti ?? '';
  const s = pend ? calcSaju(pend.a) : null;
  if (!pend || !s || typeof s === 'string' || !isMbti(code)) {
    document.getElementById('r-empty')!.hidden = false;
  } else {
    const r = sajuMbti(s, code);
    const name = honor(pend.a.name);
    const dm = DAY_MASTER[s.dayStem];
    const card = {
      kicker: `${name}의 ${code} × 사주`,
      name: r.tier.name === '사주가 증명한 진짜' ? `사주가 증명한 진짜 ${code}` : r.tier.name,
      big: `${r.sync}%`,
      line: r.tier.line,
      rows: [
        ['실제 MBTI', `${code} ${MBTI[code].name}`],
        ['사주 MBTI', `${r.pred} ${MBTI[r.pred].name}`],
      ] as [string, string][],
      seal: r.tier.seal,
      scene: { chars: code === r.pred ? [MBTI_CHAR[code]] : [MBTI_CHAR[code], MBTI_CHAR[r.pred]], theme: 'work' as const, mood: 'happy' as const },
    };
    const cardEl = document.getElementById('r-card')!;
    fillTalisman(cardEl, card);
    document.getElementById('r-body')!.hidden = false;
    replayReveal(cardEl);

    const axisHtml = r.axes
      .map(
        (a) => `<li class="py-3">
          <p class="flex items-center justify-between text-[14px] font-bold text-ink-2"><span>${a.label}</span><span class="${a.same ? 'text-ink-2' : 'text-jusa'}">${a.same ? '일치' : '반전'}</span></p>
          <div class="mt-2 grid grid-cols-[52px_1fr_52px] items-center gap-2 text-[14px]">
            <span class="${a.mine === a.a ? 'font-extrabold text-ink' : 'text-ink-3'}">${a.a} ${a.aName}</span>
            <span class="relative h-3 overflow-hidden rounded-full bg-[var(--wash)]"><i class="absolute inset-y-0 left-0 rounded-full" style="width:${a.pa}%;background:var(--c-mbti)"></i></span>
            <span class="text-right ${a.mine === a.b ? 'font-extrabold text-ink' : 'text-ink-3'}">${a.bName} ${a.b}</span>
          </div>
          <p class="mt-1 text-[13px] text-ink-3">사주 속 ${a.aName} ${a.pa}%, ${a.bName} ${100 - a.pa}%. 내 MBTI는 ${a.mine === a.a ? a.aName : a.bName}(${a.mine})</p>
          <p class="mt-2 text-[15px] leading-relaxed">${e(a.text)}</p>
        </li>`,
      )
      .join('');
    const best = MBTI_CODES.filter((c) => c !== r.pred)
      .map((c) => ({ c, s: mbtiScore(r.pred, c) }))
      .sort((x, y) => y.s - x.s)
      .slice(0, 3);
    const p = MBTI[r.pred];
    const sections = [
      block(
        '사주 MBTI 싱크로율',
        `<div class="score-ring"><span class="font-display text-[40px] font-extrabold text-jusa">${r.sync}</span><span class="font-bold">%</span><span class="tag ml-2">${e(r.tier.name)}</span></div>${paras([r.tier.text, `실제 MBTI는 ${code}, 사주가 말하는 MBTI는 ${r.pred}예요. 네 가지 성향 중 ${r.axes.filter((a) => a.same).length}가지가 같아요.`])}`,
        'mbti',
      ),
      block('네 가지 성향 비교', `<ul class="divide-y divide-[var(--line)]">${axisHtml}</ul>`, 'types'),
      block(
        `사주가 말하는 나는 ${r.pred}`,
        `<p class="font-bold">${e(p.name)}</p>${paras([p.line, p.about[0]])}${listHtml('사주 속 숨은 장점', p.strengths)}<a href="/mbti/${r.pred.toLowerCase()}/" class="btn btn-line btn-block mt-4">${r.pred} 해설 전체 보기</a>`,
        'saju',
      ),
      block(
        '겉모습과 타고난 기질',
        paras([
          `${name}은 겉으로 ${MBTI[code].name}(${code})의 모습을 하고 있지만, 사주의 중심에는 ${dm.image}의 기운이 있어요. ${dm.line}이라는 타고난 바탕 위에 ${code}의 성격이 자라난 셈이에요.`,
          r.sync >= 70
            ? '겉과 속이 같은 방향을 보고 있어서 결정이 빠르고 흔들림이 적어요. 내 성향에 맞는 환경을 고르면 실력이 그대로 성과로 이어져요.'
            : '겉과 속이 다른 방향을 볼 때가 있어서 스스로도 "내가 왜 이러지?" 싶은 순간이 있어요. 그럴 땐 사주 속 성향을 떠올려 보세요. 숨은 기질을 꺼내 쓰면 막혔던 일이 풀리기도 해요.',
        ]),
        'me',
      ),
      block(
        '사주 MBTI로 보는 찰떡 유형',
        `<ul class="space-y-2">${best.map((b) => `<li><a href="/mbti-match/${[r.pred, b.c].sort().join('-').toLowerCase()}/" class="flex items-center justify-between rounded-[14px] bg-[var(--wash)] px-4 py-3"><span><b>${b.c}</b> <span class="text-[14px] text-ink-2">${e(MBTI[b.c].name)}</span></span><span class="font-display font-extrabold text-jusa">${b.s}</span></a></li>`).join('')}</ul>
         <p class="mt-3 text-[14px] text-ink-2">사주가 말하는 ${r.pred} 기준으로 궁합 점수가 높은 유형이에요.</p>`,
        'gunghap',
      ),
    ];
    document.getElementById('r-sections')!.innerHTML = sections.join('');
    document.getElementById('r-after')!.innerHTML = `<a href="/saju/" class="btn btn-hwang btn-block">내 사주 전체 풀이 보기</a><a href="/love/group/" class="btn btn-line btn-block">친구들과 MBTI 케미 보기</a>`;

    updateShare(document.getElementById('r-share')!, {
      title: `내 사주 MBTI 싱크로율 ${r.sync}%`,
      text: `실제 ${code}, 사주로는 ${r.pred}. 생일과 MBTI만 넣으면 나도 볼 수 있어요`,
      image: new URL('/og/test-saju-mbti.png', location.origin).href,
      talisman: { ...card, head: cardEl.querySelector('.t-head')!.textContent!, foot: cardEl.querySelector('.t-foot')!.textContent! },
    });
    track('test_complete', { test: 'saju-mbti', result: `${code}-${r.pred}` });
  }
</script>
