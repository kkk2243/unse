---
import Base from '../../layouts/Base.astro';
import ResultShell from '../../components/ResultShell.astro';
---

<Base title="사주 궁합 결과" noindex back="/gunghap/" headerTitle="사주 궁합">
  <ResultShell
    id="gunghap"
    inputPath="/gunghap/"
    inputLabel="사주 궁합 보러 가기"
    head="궁합 판정"
    seal="緣"
    chars={['rabbit', 'tiger']}
    theme="love"
    shareCampaign="gunghap"
  />
</Base>

<script>
  import { getPending, honor } from '../../lib/profile';
  import { calcSaju } from '../../lib/saju';
  import { gunghapReading } from '../../lib/reading';
  import { fillTalisman, replayReveal } from '../../lib/talisman-dom';
  import { updateShare } from '../../lib/share';
  import { block, paras } from '../../lib/render';
  import { track, escapeHtml as e } from '../../lib/ui';
  import { ZODIAC_SLUG } from '../../data/reading';
  import { STEMS, ELEMENTS, BRANCHES } from '../../data/saju';

  const pend = getPending('gh');
  const a = pend ? calcSaju(pend.a) : null;
  const b = pend?.b ? calcSaju(pend.b) : null;
  if (!pend || !pend.b || !a || !b || typeof a === 'string' || typeof b === 'string') {
    document.getElementById('r-empty')!.hidden = false;
  } else {
    const g = gunghapReading(a, b, pend.a.name, pend.b.name);
    const na = honor(pend.a.name);
    const nb = honor(pend.b.name);
    const card = {
      kicker: `${na} × ${nb}`,
      name: g.tier.name,
      big: `${g.score}점`,
      line: g.tier.line,
      rows: [
        ['띠', `${g.za}띠와 ${g.zb}띠`],
        ['배우자 자리', g.palaceRel === '평' ? '무난' : g.palaceRel],
      ] as [string, string][],
      seal: g.tier.seal,
      scene: { chars: [ZODIAC_SLUG[a.yearBranch], ZODIAC_SLUG[b.yearBranch]], theme: 'love' as const, mood: g.score >= 66 ? ('happy' as const) : ('normal' as const) },
    };
    const cardEl = document.getElementById('r-card')!;
    fillTalisman(cardEl, card);
    document.getElementById('r-body')!.hidden = false;
    replayReveal(cardEl);

    const bars = `<ul class="space-y-3">${g.bars
      .map(
        (x) => `<li class="grid grid-cols-[84px_1fr_36px] items-center gap-3 text-[14.5px]"><span class="font-semibold text-ink-2">${x.label}</span>
        <span class="bar" style="--bar-c:var(--c-love)"><i style="width:${x.value}%"></i></span><span class="text-right font-display font-extrabold">${x.value}</span></li>`,
      )
      .join('')}</ul>`;
    const who = (n: string, s: typeof a) =>
      `<div class="rounded-[16px] bg-[var(--wash)] p-4"><p class="font-bold">${e(n)}</p><p class="mt-1 text-[14px] text-ink-2">${BRANCHES[s.yearBranch].animal}띠, 일간 ${STEMS[s.dayStem].ko}${ELEMENTS[STEMS[s.dayStem].el].ko}(${s.dayStem})</p><p class="text-[14px] text-ink-2">일지 ${BRANCHES[s.dayBranch].ko}(${s.dayBranch})</p></div>`;
    const ICON: Record<string, string> = { '성격 궁합': 'gunghap', '연애 스타일': 'heart', '결혼 궁합': 'ring', '띠 궁합': 'zodiac', '서로 채워 주는 기운': 'ohaeng', '연구원의 조언': 'saju' };
    document.getElementById('r-sections')!.innerHTML = [
      block('한눈에 보기', `<div class="grid grid-cols-2 gap-2">${who(na, a)}${who(nb, b)}</div><div class="mt-5">${bars}</div>`, 'gunghap'),
      ...g.sections.map((x) => block(x.title, paras([x.text]), ICON[x.title])),
    ].join('');
    document.getElementById('r-after')!.innerHTML = `<a href="/mbti-match/" class="btn btn-line btn-block">MBTI 궁합도 보기</a><a href="/love/name-match/" class="btn btn-hwang btn-block">이름 궁합도 보기</a>`;

    updateShare(document.getElementById('r-share')!, {
      title: `우리 사주 궁합 ${g.score}점, ${g.tier.name}!`,
      text: `${g.za}띠와 ${g.zb}띠. ${g.tier.line}`,
      image: new URL(`/og/gunghap/${g.tier.seal === '緣' ? 'a' : g.tier.seal === '合' ? 'b' : g.tier.seal === '和' ? 'c' : g.tier.seal === '學' ? 'd' : 'e'}.png`, location.origin).href,
      talisman: { ...card, head: cardEl.querySelector('.t-head')!.textContent!, foot: cardEl.querySelector('.t-foot')!.textContent! },
    });
    track('test_complete', { test: 'gunghap', result: String(g.score) });
  }
</script>
