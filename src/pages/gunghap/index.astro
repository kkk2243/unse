---
import InputPage from '../../components/InputPage.astro';
import InviteBox from '../../components/InviteBox.astro';

const faq = [
  { q: '사주 궁합은 어떻게 보나요?', a: '두 사람의 타고난 기운(일간)이 서로 살려 주는지 누르는지, 배우자 자리(일지)끼리 합을 이루는지 부딪히는지, 띠끼리의 관계, 서로 부족한 오행을 채워 주는지를 함께 따져서 점수를 매겨요.' },
  { q: '상대의 태어난 시간을 몰라도 되나요?', a: '네. 궁합에서 중요하게 보는 일간과 일지, 띠는 태어난 날과 해로 정해져서 시간을 몰라도 충분히 볼 수 있어요.' },
  { q: '상대의 정보도 저장되나요?', a: '아니요. 상대의 정보는 저장하지 않고 결과를 볼 때만 이 기기 안에서 계산해요. 내 정보는 저장을 선택했을 때만 이 기기에 보관돼요.' },
];
---

<InputPage
  id="gunghap"
  title="사주 궁합"
  lead="두 사람의 일간, 배우자 자리, 띠까지 꼼꼼하게 맞춰 보는 정통 궁합이에요."
  desc="두 사람의 생년월일로 보는 무료 사주 궁합. 일간의 상생상극, 배우자 자리(일지)의 합충, 띠 궁합, 오행 보완까지 따져서 성격 궁합, 연애 궁합, 결혼 궁합을 자세히 풀어 드려요."
  articleTitle="사주 궁합은 이렇게 봐요"
  article={[
    '사주 궁합은 두 사람의 사주를 나란히 놓고 기운이 어떻게 어울리는지를 보는 방법이에요. 사주 연구원은 네 가지를 함께 따져요.',
    '먼저 두 사람의 일간, 즉 나를 뜻하는 글자의 오행이 서로를 살려 주는 상생인지, 한쪽이 다스리는 상극인지, 같은 기운인지를 봐요. 다음으로 배우자 자리라고 부르는 일지끼리 합을 이루는지 부딪히는지를 봐요. 결혼 궁합에서 가장 중요하게 보는 부분이에요.',
    '여기에 띠끼리의 육합, 삼합, 충, 원진 관계와 한 사람에게 부족한 오행을 다른 사람이 채워 주는지를 더해서 100점 만점으로 매겨요. 점수와 함께 연애 스타일, 결혼 궁합, 갈등 포인트, 서로를 위한 조언을 알려드려요.',
  ]}
  faq={faq}
  kind="gh"
  resultPath="/gunghap/result/"
  gateLabel="사주 궁합을 맞춰 보고 있어요"
  gateSteps={['두 사람의 사주를 세우는 중', '일간의 상생상극을 보는 중', '배우자 자리를 맞춰 보는 중', '궁합 풀이를 정리하는 중']}
  submitLabel="궁합 보기"
  two
  chars={['rabbit', 'tiger', 'owl']}
>
  <InviteBox />
</InputPage>
