---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Gate from '../../../components/Gate.astro';
import { charSvg, MBTI_CHAR } from '../../../art/characters';
import Faq from '../../../components/Faq.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Related from '../../../components/Related.astro';
import Disclaimer from '../../../components/Disclaimer.astro';
import { TESTS, type TestDef } from '../../../data/tests';
import { catalogById } from '../../../data/catalog';
import { CATEGORIES } from '../../../config/site';
import { MBTI, MBTI_CODES } from '../../../data/mbti/types';
import { faqLd } from '../../../lib/seo';

export function getStaticPaths() {
  return TESTS.map((t) => ({ params: { slug: t.slug }, props: { test: t } }));
}

const { test } = Astro.props as { test: TestDef };
const item = catalogById(test.catalogId);
const cat = CATEGORIES[item.cats[0]];

const outcomes =
  test.scoring === 'type'
    ? Object.entries(test.results).map(([key, r]) => ({ key, name: r.name, seal: r.seal, char: key }))
    : MBTI_CODES.map((c) => ({ key: c.toLowerCase(), name: `${c} ${MBTI[c].name}`, seal: c, char: MBTI_CHAR[c] }));

const runnerData = {
  slug: test.slug,
  scoring: test.scoring,
  keys: test.scoring === 'type' ? Object.keys(test.results) : [],
  questions: test.questions,
};
---

<Base
  title={test.title}
  description={test.description}
  ogImage={`/og/test-${test.catalogId}.png`}
  crumbs={[
    { name: cat.name, path: `/category/${cat.key}/` },
    { name: test.title, path: `/test/${test.slug}/` },
  ]}
  jsonLd={[faqLd(test.faq)]}
>
  <div class="col pt-2" id="intro">
    <PageHero title={test.title} lead={test.lead} chars={item.chars} theme={item.theme} meta={`${test.questionCount}문항, ${test.minutes}분이면 끝나요`} />
    <section class="card mt-3">
      <button type="button" class="btn btn-primary btn-block" data-start>테스트 시작</button>
      <p class="mt-3 text-center text-[13px] text-ink-3">답변은 이 기기 안에서만 계산하고 어디에도 저장하지 않아요</p>
    </section>

    <AdSlot name="test-intro" />

    <article class="card prose-lab">
      <h2>이 테스트는</h2>
      {test.article.map((p) => <p>{p}</p>)}
    </article>

    <section class="card" aria-labelledby="outcomes">
      <h2 id="outcomes" class="card-title">나올 수 있는 결과 {outcomes.length}가지</h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-3 gap-y-1">
        {
          outcomes.map((o) => (
            <li>
              <a href={`/test/${test.slug}/result/${o.key}/`} class="flex items-center gap-2.5 rounded-[10px] py-1.5 hover:bg-wash">
                <span class="block h-11 w-11 flex-none" set:html={charSvg(o.char, 'happy')} />
                <span class="text-[14.5px] leading-snug font-semibold">{o.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="card" aria-labelledby="faq">
      <h2 id="faq" class="card-title">자주 묻는 질문</h2>
      <Faq items={test.faq} />
    </section>

    <button type="button" class="btn btn-jusa btn-block mt-3" data-start>지금 테스트 시작</button>

    <Related id={test.catalogId} />
    <Disclaimer mbti={test.scoring === 'mbti'} />
  </div>

  <!-- 테스트 진행 화면 -->
  <div class="runner" id="runner" hidden style={`--cat:${cat.color}`}>
    <div class="col flex h-full flex-col">
      <div class="flex h-14 flex-none items-center justify-between">
        <button type="button" class="runner-exit" data-exit aria-label="테스트 그만하기">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg
          >
        </button>
        <p class="font-display text-[16px] font-extrabold" aria-live="polite">
          <span data-current>1</span><span class="text-ink-3"> / {test.questions.length}</span>
        </p>
      </div>
      <div class="progress" aria-hidden="true"><i data-progress></i></div>

      <div class="runner-body" data-body>
        <p class="q-no font-display" data-qno>Q1</p>
        <h2 class="q-text font-display" data-qtext></h2>
        <div class="q-options" data-options role="group"></div>
      </div>

      <div class="flex-none pb-[calc(20px+env(safe-area-inset-bottom))] pt-3 text-center">
        <button type="button" class="runner-back" data-back>이전 문항</button>
      </div>
    </div>

  </div>
  <Gate slot="overlay" />

  <script type="application/json" id="test-data" set:html={JSON.stringify(runnerData)} />
</Base>

<style>
  .runner {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: var(--bg);
    overflow-y: auto;
  }
  .runner[hidden] {
    display: none;
  }
  .runner > .col {
    max-width: 480px;
    margin: 0 auto;
  }
  .runner-exit {
    width: 44px;
    height: 44px;
    margin-left: -10px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--ink-2);
  }
  .progress {
    height: 3px;
    background: var(--line);
    border-radius: 3px;
    overflow: hidden;
  }
  .progress > i {
    display: block;
    height: 100%;
    background: var(--jusa);
    width: 0;
    transition: width 0.3s ease;
  }
  .runner-body {
    flex: 1;
    padding-top: 40px;
  }
  .q-no {
    font-size: 15px;
    font-weight: 800;
    color: var(--cat);
  }
  .q-text {
    margin-top: 8px;
    font-size: 25px;
    line-height: 1.38;
    font-weight: 800;
    min-height: 2.76em;
  }
  .q-options {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  :global(.opt) {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    min-height: 64px;
    padding: 14px 18px;
    text-align: left;
    border: 1.5px solid var(--line);
    border-radius: 14px;
    font-size: 16.5px;
    font-weight: 550;
    line-height: 1.45;
    background: var(--bg);
    transition:
      border-color 0.12s,
      background-color 0.12s,
      color 0.12s;
    cursor: pointer;
  }
  :global(.opt:hover) {
    border-color: var(--ink-3);
  }
  :global(.opt b) {
    flex: none;
    font-family: 'Hahmlet Variable', serif;
    font-weight: 800;
    font-size: 17px;
    color: var(--cat);
    width: 18px;
  }
  :global(.opt[aria-pressed='true']) {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  :global(.opt[aria-pressed='true'] b) {
    color: var(--hwang);
  }
  .runner-back {
    min-height: 44px;
    padding: 0 16px;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .runner-back:disabled {
    visibility: hidden;
  }
  @media (prefers-reduced-motion: no-preference) {
    .runner-body.enter {
      animation: q-in 0.28s ease-out both;
    }
  }
  @keyframes q-in {
    from {
      opacity: 0;
      transform: translateX(16px);
    }
  }
</style>

<script>
  import { track } from '../../../lib/ui';
  import { openGate } from '../../../lib/gate';

  type Opt = { text: string; score?: Record<string, number>; axis?: string };
  type Data = { slug: string; scoring: 'type' | 'mbti'; keys: string[]; questions: { q: string; options: Opt[] }[] };

  const data: Data = JSON.parse(document.getElementById('test-data')!.textContent!);
  const runner = document.getElementById('runner')!;
  const $ = <T extends HTMLElement>(sel: string) => runner.querySelector<T>(sel)!;
  const body = $('[data-body]');
  const qno = $('[data-qno]');
  const qtext = $('[data-qtext]');
  const opts = $('[data-options]');
  const cur = $('[data-current]');
  const bar = $('[data-progress]');
  const back = $<HTMLButtonElement>('[data-back]');
  const letters = ['A', 'B', 'C', 'D', 'E', 'F'];

  let answers: number[] = [];
  let index = 0;
  let locked = false;

  function render(i: number) {
    index = i;
    const q = data.questions[i];
    qno.textContent = `Q${i + 1}`;
    qtext.textContent = q.q;
    cur.textContent = String(i + 1);
    bar.style.width = `${(i / data.questions.length) * 100}%`;
    back.disabled = i === 0;
    opts.innerHTML = '';
    q.options.forEach((o, k) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'opt';
      b.setAttribute('aria-pressed', String(answers[i] === k));
      b.innerHTML = `<b>${letters[k]}</b><span></span>`;
      b.querySelector('span')!.textContent = o.text;
      b.addEventListener('click', () => choose(k, b));
      opts.appendChild(b);
    });
    body.classList.remove('enter');
    void body.offsetWidth;
    body.classList.add('enter');
    runner.scrollTop = 0;
  }

  function choose(k: number, btn: HTMLButtonElement) {
    if (locked) return;
    locked = true;
    answers[index] = k;
    opts.querySelectorAll('.opt').forEach((el) => el.setAttribute('aria-pressed', 'false'));
    btn.setAttribute('aria-pressed', 'true');
    setTimeout(() => {
      locked = false;
      if (index < data.questions.length - 1) {
        history.pushState({ q: index + 1 }, '');
        render(index + 1);
      } else {
        finish();
      }
    }, 220);
  }

  function resultTypeTest() {
    const score: Record<string, number> = {};
    const prim: Record<string, number> = {};
    let h = 0;
    answers.forEach((a, i) => {
      const o = data.questions[i].options[a];
      h += (i + 1) * (a + 1);
      for (const [k, v] of Object.entries(o.score ?? {})) {
        score[k] = (score[k] ?? 0) + v;
        if (v >= 2) prim[k] = (prim[k] ?? 0) + 1;
      }
    });
    let best = -1;
    let ties: string[] = [];
    for (const k of data.keys) {
      const s = (score[k] ?? 0) * 100 + (prim[k] ?? 0);
      if (s > best) {
        best = s;
        ties = [k];
      } else if (s === best) ties.push(k);
    }
    return { key: ties[h % ties.length], extra: '' };
  }

  function resultMbti() {
    const c: Record<string, number> = { E: 0, I: 0, S: 0, N: 0, T: 0, F: 0, J: 0, P: 0 };
    answers.forEach((a, i) => {
      const ax = data.questions[i].options[a].axis!;
      c[ax]++;
    });
    const pct = (x: string, y: string) => Math.round((c[x] / Math.max(1, c[x] + c[y])) * 100);
    const type = (c.E >= c.I ? 'E' : 'I') + (c.S > c.N ? 'S' : 'N') + (c.T > c.F ? 'T' : 'F') + (c.J > c.P ? 'J' : 'P');
    const p = [pct('E', 'I'), pct('S', 'N'), pct('T', 'F'), pct('J', 'P')].join('.');
    return { key: type.toLowerCase(), extra: `&p=${p}` };
  }

  function finish() {
    bar.style.width = '100%';
    const { key, extra } = data.scoring === 'mbti' ? resultMbti() : resultTypeTest();
    track('test_complete', { test: data.slug, result: key });
    openGate({
      name: '답변 ' + data.questions.length + '개로 ',
      label: '결과를 찾고 있어요',
      steps: ['답변을 모으는 중', '점수를 더하는 중', '닮은 유형을 찾는 중', '결과 부적을 쓰는 중'],
      href: `/test/${data.slug}/result/${key}/?from=test${extra}`,
      chars: data.scoring === 'mbti' ? ['deer', 'cat', 'fox'] : ['fox', 'whale', 'bear'],
      test: data.slug,
      ms: 3600,
    });
  }

  function open() {
    answers = [];
    runner.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    history.pushState({ q: 0 }, '');
    render(0);
    track('test_start', { test: data.slug });
  }

  function close() {
    runner.hidden = true;
    document.documentElement.style.overflow = '';
  }

  document.querySelectorAll('[data-start]').forEach((b) => b.addEventListener('click', open));
  $('[data-exit]').addEventListener('click', () => history.go(-(index + 1)));
  back.addEventListener('click', () => history.back());
  window.addEventListener('popstate', (e) => {
    const s = e.state as { q?: number } | null;
    if (s && typeof s.q === 'number' && !runner.hidden) render(s.q);
    else close();
  });
  // 결과 페이지에서 뒤로 왔을 때 진행 화면이 남아 있지 않도록
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) close();
  });
</script>
