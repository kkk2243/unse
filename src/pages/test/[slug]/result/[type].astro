---
import Base from '../../../../layouts/Base.astro';
import Talisman from '../../../../components/Talisman.astro';
import ShareBar from '../../../../components/ShareBar.astro';
import { charSvg, MBTI_CHAR } from '../../../../art/characters';
import AdSlot from '../../../../components/AdSlot.astro';
import Related from '../../../../components/Related.astro';
import Disclaimer from '../../../../components/Disclaimer.astro';
import { TESTS, type TestDef, type TypeTest } from '../../../../data/tests';
import { catalogById } from '../../../../data/catalog';
import { CATEGORIES, SITE, siteFoot } from '../../../../config/site';
import { MBTI, MBTI_CODES, type MbtiCode } from '../../../../data/mbti/types';
import { mbtiScore, pairSlug } from '../../../../data/mbti/compat';

export function getStaticPaths() {
  return TESTS.flatMap((t) => {
    const keys = t.scoring === 'type' ? Object.keys(t.results) : MBTI_CODES.map((c) => c.toLowerCase());
    return keys.map((type) => ({ params: { slug: t.slug, type }, props: { test: t, type } }));
  });
}

const { test, type } = Astro.props as { test: TestDef; type: string };
const item = catalogById(test.catalogId);
const cat = CATEGORIES[item.cats[0]];
const startPath = `/test/${test.slug}/`;
const path = `/test/${test.slug}/result/${type}/`;
const foot = siteFoot(Astro.site);

// 결과 공통 형태로 정리
let r: { name: string; seal: string; line: string; keys: string[]; about: string[]; strengths: string[]; weaknesses: string[] };
let typeTest: TypeTest | null = null;
let code: MbtiCode | null = null;
if (test.scoring === 'type') {
  typeTest = test;
  const t = test.results[type];
  r = t;
} else {
  code = type.toUpperCase() as MbtiCode;
  const m = MBTI[code];
  r = { name: code, seal: code, line: `${m.name}. ${m.line}`, keys: m.keys, about: m.about, strengths: m.strengths, weaknesses: m.weaknesses };
}

const charId = code ? MBTI_CHAR[code] : type;
const displayName = code ? `${code} ${MBTI[code].name}` : r.name;
const title = `${displayName} | ${test.title} 결과`;
const shareTitle = `나는 '${displayName}' 유형! 너는?`;

const others =
  test.scoring === 'type'
    ? Object.entries(test.results)
        .filter(([k]) => k !== type)
        .map(([k, v]) => ({ key: k, name: v.name, seal: v.seal, char: k }))
    : MBTI_CODES.filter((c) => c !== code).map((c) => ({ key: c.toLowerCase(), name: c, seal: c, char: MBTI_CHAR[c] }));

const bestMatches = code
  ? MBTI_CODES.filter((c) => c !== code)
      .map((c) => ({ c, s: mbtiScore(code!, c) }))
      .sort((a, b) => b.s - a.s)
      .slice(0, 3)
  : [];
---

<Base
  title={title}
  description={`${r.line} ${test.title} 결과: ${displayName}. 강점과 약점, 잘 맞는 유형까지 확인해 보세요.`}
  ogImage={`/og/r/${test.slug}-${type}.png`}
  crumbs={[
    { name: test.title, path: startPath },
    { name: displayName, path },
  ]}
>
  <div class="col pt-2">
    <div id="result-card">
      <Talisman
        head={test.resultHead}
        kicker={test.resultKicker}
        name={r.name}
        line={r.line}
        keys={r.keys}
        seal={r.seal}
        chars={[charId]}
        theme={code ? 'work' : 'group'}
      />
    </div>
    <script is:inline>
      if (/[?&]from=test/.test(location.search)) document.getElementById('result-card').classList.add('reveal');
    </script>

    {
      code && (
        <div class="card mt-3 hidden" id="axis-bars" aria-label="지표별 비율">
          {[
            ['E', 'I', '외향', '내향'],
            ['S', 'N', '감각', '직관'],
            ['T', 'F', '사고', '감정'],
            ['J', 'P', '판단', '인식'],
          ].map(([a, b, la, lb]) => (
            <div class="axis-row" data-axis={a}>
              <span class="axis-l">
                <b>{a}</b> {la}
              </span>
              <span class="axis-track">
                <i />
              </span>
              <span class="axis-r">
                {lb} <b>{b}</b>
              </span>
              <span class="axis-pct" />
            </div>
          ))}
        </div>
      )
    }

    <!-- 공유로 들어온 사람에게 보이는 영역 -->
    <div class="card mt-3" data-visitor>
      <a href={startPath} class="btn btn-jusa btn-block">나도 테스트하기</a>
      <p class="mt-3 text-center text-[14px] text-ink-2">{test.questionCount}문항, {test.minutes}분이면 내 결과가 나와요</p>
    </div>

    <section class="card mt-3" aria-label="공유">
      <ShareBar
        title={shareTitle}
        text={r.line}
        path={path}
        ctaPath={startPath}
        ogImage={`/og/r/${test.slug}-${type}.png`}
        campaign={test.slug}
        talisman={{
          head: `${SITE.name} ${test.resultHead}`,
          kicker: test.resultKicker,
          name: r.name,
          line: r.line,
          keys: r.keys,
          seal: r.seal,
          foot,
          scene: { chars: [charId], theme: code ? 'work' : 'group', mood: 'happy' },
        }}
      />
      <div class="mt-4 hidden" data-tester>
        <a href={startPath} class="btn btn-line btn-block">다시 하기</a>
      </div>
    </section>

    <AdSlot name="result-top" />

    <article class="card prose-lab">
      <h2>{code ? `${code}는 이런 사람이에요` : '이런 사람이에요'}</h2>
      {r.about.map((p) => <p>{p}</p>)}

      <h2>강점</h2>
      <ul>{r.strengths.map((s) => <li>{s}</li>)}</ul>

      <h2>약점</h2>
      <ul>{r.weaknesses.map((s) => <li>{s}</li>)}</ul>
    </article>

    <AdSlot name="result-article" />

    {
      typeTest && (
        <section class="card">
          <h2 class="card-title">잘 맞는 동물</h2>
          <ul class="rows mt-2">
            {typeTest.results[type].good.map((k) => (
              <li>
                <a href={`/test/${test.slug}/result/${k}/`} class="row-link">
                  <span class="thumb" set:html={charSvg(k, 'happy')} />
                  <span class="flex-1">
                    <span class="row-title block font-semibold">{typeTest!.results[k].name}</span>
                    <span class="block text-[14px] text-ink-2">{typeTest!.results[k].line}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <h2 class="card-title mt-6">부딪히기 쉬운 동물</h2>
          <ul class="rows mt-2">
            {typeTest.results[type].bad.map((k) => (
              <li>
                <a href={`/test/${test.slug}/result/${k}/`} class="row-link">
                  <span class="thumb" set:html={charSvg(k, 'normal')} />
                  <span class="flex-1">
                    <span class="row-title block font-semibold">{typeTest!.results[k].name}</span>
                    <span class="block text-[14px] text-ink-2">{typeTest!.results[k].line}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <div class="note mt-6">
            <p class="note-head">연구소의 한마디</p>
            <p class="mt-1">{typeTest.results[type].tip}</p>
          </div>
        </section>
      )
    }

    {
      code && (
        <section class="card">
          <h2 class="card-title">{code}와 잘 맞는 유형</h2>
          <ul class="rows mt-2">
            {bestMatches.map(({ c, s }) => (
              <li>
                <a href={`/mbti-match/${pairSlug(code!, c)}/`} class="row-link">
                  <span class="thumb" set:html={charSvg(MBTI_CHAR[c], 'happy')} />
                  <span class="flex-1">
                    <span class="row-title block font-semibold">
                      {code} × {c}
                    </span>
                    <span class="block text-[14px] text-ink-2">{MBTI[c].name}</span>
                  </span>
                  <span class="font-display text-[20px] font-extrabold text-jusa">{s}점</span>
                </a>
              </li>
            ))}
          </ul>
          <a href={`/mbti/${type}/`} class="btn btn-line btn-block mt-6">
            {code}의 연애, 직장, 친구 관계 더 보기
          </a>
        </section>
      )
    }

    <section class="card" aria-labelledby="others">
      <h2 id="others" class="card-title">다른 결과 구경하기</h2>
      <ul class="mt-4 grid grid-cols-4 gap-x-2 gap-y-4 text-center">
        {
          others.map((o) => (
            <li>
              <a href={`/test/${test.slug}/result/${o.key}/`} class="flex flex-col items-center gap-1.5">
                <span class="block h-14 w-14" set:html={charSvg(o.char, 'happy')} />
                <span class="text-[12.5px] leading-tight font-semibold text-ink-2">{o.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <Related id={test.catalogId} />
    <Disclaimer mbti={test.scoring === 'mbti'} />
  </div>
</Base>

<style>
  .note-head {
    font-weight: 700;
    font-size: 14px;
    color: var(--jusa);
  }
  .axis-row {
    display: grid;
    grid-template-columns: 58px 1fr 58px 54px;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    color: var(--ink-2);
  }
  .axis-row + .axis-row {
    margin-top: 10px;
  }
  .axis-row b {
    font-family: 'Hahmlet Variable', serif;
    color: var(--ink);
  }
  .axis-r {
    text-align: right;
  }
  .axis-track {
    position: relative;
    height: 10px;
    background: var(--wash);
    border-radius: 99px;
    overflow: hidden;
  }
  .axis-track > i {
    position: absolute;
    top: 0;
    bottom: 0;
    background: var(--cheong);
    border-radius: 99px;
  }
  .axis-pct {
    text-align: right;
    font-weight: 700;
    color: var(--ink);
  }
</style>

<script>
  const params = new URLSearchParams(location.search);
  const fromTest = params.get('from') === 'test';
  if (fromTest) {
    document.querySelector<HTMLElement>('[data-visitor]')!.hidden = true;
    document.querySelector<HTMLElement>('[data-tester]')!.classList.remove('hidden');
    params.delete('from');
    const q = params.toString();
    history.replaceState(history.state, '', location.pathname + (q ? `?${q}` : ''));
  }
  // MBTI 지표 비율 (p=E%.S%.T%.J%)
  const p = params.get('p');
  const bars = document.getElementById('axis-bars');
  if (bars && p && /^\d{1,3}(\.\d{1,3}){3}$/.test(p)) {
    const v = p.split('.').map(Number);
    bars.querySelectorAll<HTMLElement>('.axis-row').forEach((row, i) => {
      const left = Math.min(100, Math.max(0, v[i]));
      const i_ = row.querySelector<HTMLElement>('.axis-track > i')!;
      const winLeft = left >= 50;
      i_.style.left = winLeft ? '0' : `${left}%`;
      i_.style.right = winLeft ? `${100 - left}%` : '0';
      const letters = ['EI', 'SN', 'TF', 'JP'][i];
      row.querySelector('.axis-pct')!.textContent = `${winLeft ? letters[0] : letters[1]} ${winLeft ? left : 100 - left}%`;
    });
    bars.classList.remove('hidden');
  }
</script>
