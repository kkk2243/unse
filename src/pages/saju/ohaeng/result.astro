---
import Base from '../../../layouts/Base.astro';
import ResultShell from '../../../components/ResultShell.astro';
---

<Base title="오행 진단 결과" noindex back="/saju/ohaeng/" headerTitle="오행 부족 진단">
  <ResultShell
    id="ohaeng"
    inputPath="/saju/ohaeng/"
    inputLabel="오행 진단 하러 가기"
    head="오행 진단"
    seal="五行"
    chars={['tree']}
    theme="study"
    shareCampaign="ohaeng"
  />
</Base>

<script>
  import { getPending, currentProfile, honor } from '../../../lib/profile';
  import { calcSaju } from '../../../lib/saju';
  import { fillTalisman, replayReveal } from '../../../lib/talisman-dom';
  import { updateShare } from '../../../lib/share';
  import { block, paras, elementBars, luckyHtml } from '../../../lib/render';
  import { track, escapeHtml as e } from '../../../lib/ui';
  import { ELEMENT_CHAR } from '../../../art/characters';
  import { ELEMENTS } from '../../../data/saju';
  import { HEALTH_WEAK } from '../../../data/reading';
  import { josa } from '../../../lib/hangul';

  const pend = getPending('ohaeng') ?? (currentProfile() ? { kind: 'ohaeng', a: currentProfile()! } : null);
  const s = pend ? calcSaju(pend.a) : null;
  if (!pend || !s || typeof s === 'string') {
    document.getElementById('r-empty')!.hidden = false;
  } else {
    const need = ELEMENTS[s.weakest];
    const strong = ELEMENTS[s.strongest];
    const name = honor(pend.a.name);
    const card = {
      kicker: `${name}에게 필요한 기운은`,
      name: `${need.name}의 기운`,
      line:
        s.counts[s.weakest] === 0
          ? `사주에 ${need.name}(${need.hanja})${josa(need.name, '이', '가')} 하나도 없어요`
          : `사주에 ${need.name}(${need.hanja})${josa(need.name, '이', '가')} ${s.counts[s.weakest]}개뿐이에요`,
      rows: [
        ['행운의 색', need.colorName],
        ['행운의 숫자', need.numbers],
        ['좋은 방향', need.direction],
      ] as [string, string][],
      seal: need.hanja,
      scene: { chars: [ELEMENT_CHAR[s.weakest]], theme: 'study' as const, mood: 'happy' as const },
    };
    const cardEl = document.getElementById('r-card')!;
    fillTalisman(cardEl, card);
    document.getElementById('r-body')!.hidden = false;
    replayReveal(cardEl);

    const fill = `<ul class="space-y-2">${need.fill.map((f) => `<li class="flex gap-2"><span class="text-jusa">◆</span><span>${e(f)}</span></li>`).join('')}</ul>`;
    document.getElementById('r-sections')!.innerHTML = [
      block('내 사주의 오행', `<p class="text-[14px] text-ink-2">양력 ${e(s.solarText)}, ${s.total}글자 기준</p><div class="mt-3">${elementBars(s)}</div>`, 'ohaeng'),
      block(`${need.name} 기운이 부족하면`, paras([need.weak, HEALTH_WEAK[s.weakest]]), 'ohaeng'),
      block(`${need.name} 기운을 채우는 방법`, fill, 'clover'),
      block('행운 아이템', luckyHtml({ element: s.weakest, color: need.colorName, number: need.numbers, direction: need.direction, food: need.food }), 'coin'),
      block(`대신 ${strong.name} 기운은 넉넉해요`, paras([strong.strong]), 'today'),
      s.missing.length > 1 ? block('함께 챙기면 좋은 기운', paras([`${s.missing.map((m) => ELEMENTS[m].name).join(', ')} 기운이 모두 없는 사주예요. 가장 먼저 ${need.name} 기운부터 채워 보세요.`]), 'ohaeng') : '',
    ].join('');
    document.getElementById('r-after')!.innerHTML = `<a href="/saju/" class="btn btn-hwang btn-block">사주 여덟 글자 전체 풀이 보기</a>`;

    updateShare(document.getElementById('r-share')!, {
      title: `나한테 부족한 건 ${need.name}의 기운이래`,
      text: `행운의 색은 ${need.colorName}, 숫자는 ${need.numbers}`,
      image: new URL(`/og/ohaeng/${s.weakest}.png`, location.origin).href,
      talisman: { ...card, head: cardEl.querySelector('.t-head')!.textContent!, foot: cardEl.querySelector('.t-foot')!.textContent! },
    });
    track('test_complete', { test: 'ohaeng', result: s.weakest });
  }
</script>
