---
import Base from '../../layouts/Base.astro';
import ResultShell from '../../components/ResultShell.astro';
---

<Base title="사주 풀이 결과" noindex back="/saju/" headerTitle="정통 사주 풀이">
  <ResultShell
    id="saju"
    inputPath="/saju/"
    inputLabel="사주 풀이 보러 가기"
    head="사주 판정"
    seal="四柱"
    chars={['owl']}
    theme="study"
    shareCampaign="saju"
  />
</Base>

<script>
  import { getPending, currentProfile, honor } from '../../lib/profile';
  import { calcSaju, GROUP_KO } from '../../lib/saju';
  import { natalReading } from '../../lib/reading';
  import { fillTalisman, replayReveal } from '../../lib/talisman-dom';
  import { updateShare } from '../../lib/share';
  import { block, paras, pillarTable, elementBars, groupBars, luckyHtml, listHtml } from '../../lib/render';
  import { track, escapeHtml as e } from '../../lib/ui';
  import { DAY_MASTER_CHAR } from '../../art/characters';
  import { STEMS, ELEMENTS, BRANCHES } from '../../data/saju';
  import { CAT_ICON } from '../../art/icons';
  import { iljuSlug, iljuKo, iljuName } from '../../lib/ilju';

  const pend = getPending('saju') ?? (currentProfile() ? { kind: 'saju', a: currentProfile()! } : null);
  const s = pend ? calcSaju(pend.a) : null;
  if (!pend || !s || typeof s === 'string') {
    document.getElementById('r-empty')!.hidden = false;
  } else {
    const n = natalReading(s, pend.a.gender);
    const name = honor(pend.a.name);
    const el = ELEMENTS[STEMS[s.dayStem].el];
    const card = {
      kicker: `${name}의 타고난 기운은 ${STEMS[s.dayStem].ko}${el.ko}(${s.dayStem}${el.hanja})`,
      name: n.dm.image,
      line: n.dm.line,
      keys: n.dm.keys,
      rows: [
        ['사주 구성', `${s.strength === 'strong' ? '신강' : s.strength === 'weak' ? '신약' : '중화'}, ${GROUP_KO[n.dominant]} 강함`],
        ['보완할 기운', `${ELEMENTS[s.weakest].name}(${ELEMENTS[s.weakest].hanja})`],
      ] as [string, string][],
      seal: s.dayStem,
      scene: { chars: [DAY_MASTER_CHAR[s.dayStem]], theme: 'study' as const, mood: 'happy' as const },
    };
    const cardEl = document.getElementById('r-card')!;
    fillTalisman(cardEl, card);
    document.getElementById('r-body')!.hidden = false;
    replayReveal(cardEl);

    const ICON: Record<string, string> = { ilju: 'me', gods: 'types', stages: 'clock', me: 'saju', strength: 'ohaeng', groups: 'types', love: CAT_ICON.love, marriage: CAT_ICON.marriage, money: CAT_ICON.money, work: CAT_ICON.work, business: CAT_ICON.business, health: CAT_ICON.health, study: CAT_ICON.study, people: CAT_ICON.people };
    const chart = block(
      '나의 사주 여덟 글자',
      `<p class="text-[14px] text-ink-2">양력 ${e(s.solarText)}, ${e(s.lunarText)}, ${BRANCHES[s.yearBranch].animal}띠${s.hasTime ? '' : ' (태어난 시간 모름)'}</p>
       <div class="mt-3">${pillarTable(s)}</div>
       <p class="mt-3 text-[13.5px] text-ink-3">글자 위의 작은 이름은 나(일간)를 기준으로 본 십신이에요.</p>`,
      'saju',
    );
    const balance = block('오행과 십신 분포', `<h4 class="text-[14px] font-bold text-ink-2">오행</h4><div class="mt-2">${elementBars(s)}</div><h4 class="mt-5 text-[14px] font-bold text-ink-2">십신</h4><div class="mt-2">${groupBars(s)}</div>`, 'ohaeng');
    const sec = Object.fromEntries(n.sections.map((x) => [x.key, block(x.title, paras(x.paras) + (x.list ?? []).map((l, i) => listHtml(l.label, l.items, i === 1)).join(''), ICON[x.key])]));
    const daeun = n.daeun.length
      ? block(
          '대운의 흐름',
          `<p class="text-[14.5px] text-ink-2">10년마다 바뀌는 큰 운이에요. 빨간 점이 지금 지나고 있는 대운이에요.</p>
          <ol class="timeline mt-4">${n.daeun
            .map(
              (d) => `<li class="${d.current ? 'now' : ''}"><p class="flex items-center gap-2 text-[15px] font-bold">${d.startAge}세~ <span class="font-display text-[17px]">${d.stem}${d.branch}</span><span class="tag ${d.good ? '' : 'tag-red'}">${d.good ? '힘이 되는 시기' : '다지는 시기'}</span></p>
              <p class="text-[14.5px] text-ink-2">${d.startYear}~${d.endYear}년. ${e(d.line)}</p></li>`,
            )
            .join('')}</ol>`,
          'clock',
        )
      : '';
    const lucky = block('나를 돕는 행운 아이템', luckyHtml(n.lucky), 'clover');
    document.getElementById('r-sections')!.innerHTML = [sec.me, chart, sec.ilju, `<a href="/ilju/${iljuSlug(s.dayStem + s.dayBranch)}/" class="btn btn-line btn-block">${iljuKo(s.dayStem + s.dayBranch)}일주(${iljuName(s.dayStem + s.dayBranch)}) 도감 보기</a>`, sec.strength, balance, sec.groups, sec.gods, sec.stages, sec.love, sec.marriage, sec.money, sec.work, daeun, sec.business, sec.health, sec.study, sec.people, lucky].join('');
    document.getElementById('r-after')!.innerHTML = `<a href="/newyear/" class="btn btn-hwang btn-block">내 2027년 신년운세 보기</a>`;

    updateShare(document.getElementById('r-share')!, {
      title: `내 사주는 '${n.dm.image}'래`,
      text: n.dm.line,
      image: new URL(`/og/saju/${encodeURIComponent(DAY_MASTER_CHAR[s.dayStem])}.png`, location.origin).href,
      talisman: { ...card, head: cardEl.querySelector('.t-head')!.textContent!, foot: cardEl.querySelector('.t-foot')!.textContent! },
    });
    track('test_complete', { test: 'saju', result: s.dayStem });
  }
</script>
