---
import InputPage from '../../components/InputPage.astro';

const faq = [
  {
    q: '사주 여덟 글자가 뭔가요?',
    a: '태어난 해, 달, 날, 시를 각각 하늘의 기운(천간)과 땅의 기운(지지) 두 글자로 나타낸 거예요. 네 기둥에 두 글자씩, 모두 여덟 글자라서 사주팔자라고 불러요.',
  },
  { q: '성별은 왜 필요한가요?', a: '10년마다 바뀌는 큰 운, 대운이 흘러가는 방향이 성별에 따라 달라져요. 결혼운에서 배우자를 뜻하는 기운을 고를 때도 성별을 참고해요.' },
  { q: '태어난 시간을 모르면 어떻게 하나요?', a: '시간을 모름으로 두면 해, 달, 날의 여섯 글자로 풀어 드려요. 타고난 성격을 뜻하는 일간은 태어난 날로 정해져서 큰 흐름은 그대로 볼 수 있어요.' },
  { q: '양력과 음력 중 무엇을 넣어야 하나요?', a: '알고 있는 생일 그대로 넣고 양력인지 음력인지만 골라 주세요. 음력 윤달생이라면 윤달에 체크해 주세요.' },
];
---

<InputPage
  id="saju"
  title="정통 사주 풀이"
  lead="사주 여덟 글자와 대운으로 타고난 성격, 연애, 결혼, 직업, 재물까지 풀어 드려요."
  desc="생년월일과 태어난 시간으로 보는 무료 정통 사주 풀이. 사주 여덟 글자와 십신, 신강·신약, 오행 분포, 대운의 흐름으로 성격, 연애운, 결혼운, 재물운, 직업운, 사업운, 건강운, 학업운, 대인관계운을 자세히 풀어 드려요."
  articleTitle="정통 사주는 이렇게 풀어요"
  article={[
    '사주는 태어난 해, 달, 날, 시를 네 개의 기둥으로 세우고, 기둥마다 하늘의 기운인 천간과 땅의 기운인 지지를 하나씩 붙여 여덟 글자로 나타내요. 사주 연구원은 검증된 만세력 계산으로 절기를 따져 정확한 간지를 뽑아요.',
    '여덟 글자 중 가장 중요한 건 태어난 날의 천간, 일간이에요. 사주에서 \'나 자신\'을 뜻하는 글자라서 큰 나무, 태양, 바다 같은 자연에 빗대어 타고난 성격을 풀어요. 그다음 나머지 일곱 글자가 나에게 어떤 의미인지를 열 가지 십신으로 나누고, 나를 돕는 기운이 강한지 약한지(신강·신약)를 따져요.',
    '이 결과를 바탕으로 연애운, 결혼운, 재물운, 직업운, 사업운, 건강운, 학업운, 대인관계운을 하나씩 풀고, 10년마다 바뀌는 대운의 흐름도 함께 보여드려요.',
  ]}
  faq={faq}
  kind="saju"
  resultPath="/saju/result/"
  gateLabel="정통 사주를 풀이하고 있어요"
  gateSteps={['사주 여덟 글자를 세우는 중', '십신과 신강·신약을 따지는 중', '대운의 흐름을 계산하는 중', '분야별 풀이를 정리하는 중']}
  submitLabel="사주 풀이 보기"
  chars={['owl', 'tree', 'sea']}
/>
