---
// 광고 자리. 애드센스 클라이언트 ID와 슬롯 ID가 둘 다 있을 때만 광고가 나옵니다.
// 개발 중(npm run dev)에는 자리 표시만 보여주고, 배포본에서 빈 자리는 아예 그리지 않습니다.
// lazy: 처음엔 숨겨져 있다가 나중에 보이는 자리(분석 중 화면)용. 보일 때 lib/ads.ts의 fillAds()로 채웁니다.
import { ENV, AD_SLOTS } from '../config/site';

interface Props {
  name: string;
  format?: 'auto' | 'fluid' | 'rectangle';
  lazy?: boolean;
}
const { name, format = 'auto', lazy = false } = Astro.props;
const slot = AD_SLOTS[name] ?? '';
const live = Boolean(ENV.adsenseClient && slot);
const dev = import.meta.env.DEV;
---

{
  live ? (
    <div class="ad-slot" data-ad={name}>
      <ins
        class="adsbygoogle"
        style={format === 'rectangle' ? 'display:inline-block;width:300px;height:250px' : 'display:block'}
        data-ad-client={ENV.adsenseClient}
        data-ad-slot={slot}
        data-ad-format={format === 'rectangle' ? undefined : format}
        data-full-width-responsive={format === 'rectangle' ? undefined : 'true'}
        data-lazy={lazy ? '1' : undefined}
      />
      {!lazy && <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>}
    </div>
  ) : dev ? (
    <div class="ad-slot">
      <div class="ad-placeholder" style={format === 'rectangle' ? 'width:300px;height:250px;margin:0 auto' : ''}>
        광고 자리 ({name})
      </div>
    </div>
  ) : null
}
