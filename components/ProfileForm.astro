---
// 이름, 성별, 생년월일, 태어난 시간 입력 + 저장된 사람 고르기
import BirthInput from './BirthInput.astro';

interface Props {
  prefix: string;
  who?: string; // '나', '상대' 등 (궁합처럼 두 사람일 때)
  save?: boolean; // '이 기기에 저장' 체크 표시
  time?: boolean;
}
const { prefix, who, save = true, time = true } = Astro.props;
---

<div class="pf" data-profile-form={prefix}>
  {who && <p class="mb-3 text-[15px] font-bold">{who}</p>}
  <div class="pf-saved mb-4" data-saved-chips hidden>
    <p class="field-label">저장된 사람</p>
    <div class="flex flex-wrap gap-2" data-chip-list></div>
  </div>
  <div class="grid grid-cols-[1fr_128px] gap-2.5">
    <div>
      <label class="field-label" for={`${prefix}-name`}>이름</label>
      <input class="field" id={`${prefix}-name`} name={`${prefix}-name`} maxlength="10" autocomplete="off" placeholder="이름 또는 별명" />
    </div>
    <div>
      <span class="field-label">성별</span>
      <div class="seg" role="radiogroup" aria-label="성별">
        <label><input type="radio" name={`${prefix}-gender`} value="F" checked />여자</label>
        <label><input type="radio" name={`${prefix}-gender`} value="M" />남자</label>
      </div>
    </div>
  </div>
  <div class="mt-4">
    <BirthInput prefix={prefix} calendar time={time} />
  </div>
  {
    save && (
      <label class="mt-4 flex items-start gap-2.5 text-[14.5px] leading-snug text-ink-2">
        <input type="checkbox" name={`${prefix}-save`} checked class="mt-0.5 h-5 w-5 flex-none accent-[var(--jusa)]" />
        <span>다음에 바로 볼 수 있게 이 기기에 저장하기 (서버로 보내지 않아요)</span>
      </label>
    )
  }
</div>

<script>
  import { profiles, birthLabel, type Profile } from '../lib/profile';
  import { fillProfileForm } from '../lib/profile-form';

  document.querySelectorAll<HTMLElement>('[data-profile-form]').forEach((root) => {
    const prefix = root.dataset.profileForm!;
    const list = profiles();
    const box = root.querySelector<HTMLElement>('[data-saved-chips]')!;
    const chips = root.querySelector<HTMLElement>('[data-chip-list]')!;
    if (!list.length) return;
    box.hidden = false;
    const form = root.closest('form')!;
    const render = (activeId?: string) => {
      chips.innerHTML = '';
      list.forEach((p: Profile) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'chip';
        b.setAttribute('aria-pressed', String(p.id === activeId));
        b.textContent = `${p.name} ${birthLabel(p)}`;
        b.addEventListener('click', () => {
          fillProfileForm(form, prefix, p);
          render(p.id);
        });
        chips.appendChild(b);
      });
    };
    render();
    // 첫 번째 사람 칸은 최근 사람으로 미리 채움
    if (root.dataset.autofill !== 'off' && prefix.endsWith('a')) {
      fillProfileForm(form, prefix, list[0]);
      render(list[0].id);
    }
  });
</script>
