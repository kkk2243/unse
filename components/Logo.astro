---
import { charSvg } from '../art/characters';
interface Props {
  size?: number;
}
const { size = 34 } = Astro.props;
---

<span class="logo-mark" style={`width:${size}px;height:${size}px`} set:html={charSvg('owl', 'normal')} />

<style>
  .logo-mark {
    display: inline-block;
    flex: none;
  }
  .logo-mark :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
