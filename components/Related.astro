---
import { sceneSvg } from '../art/characters';
import { related } from '../data/catalog';

interface Props {
  id: string;
  title?: string;
}
const { id, title = '이것도 해 보세요' } = Astro.props;
const items = related(id, 6);
---

<section class="card mt-3" aria-labelledby={`related-${id}`}>
  <h2 id={`related-${id}`} class="card-title">{title}</h2>
  <div class="hscroll">
    {
      items.map((it) => (
        <a href={it.path} class="tile">
          <span class="tile-art" set:html={sceneSvg({ chars: it.chars, theme: it.theme })} />
          <span class="tile-title">{it.title}</span>
        </a>
      ))
    }
  </div>
</section>
