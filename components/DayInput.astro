---
// 오늘·내일·지정일 운세 입력 화면 (결과는 /fortune/result/)
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import ProfileForm from './ProfileForm.astro';
import Faq from './Faq.astro';
import Related from './Related.astro';
import Disclaimer from './Disclaimer.astro';
import AdSlot from './AdSlot.astro';
import Gate from './Gate.astro';
import { faqLd } from '../lib/seo';
import { catalogById } from '../data/catalog';

interface Props {
  mode: 'today' | 'tomorrow' | 'date';
}
const { mode } = Astro.props;
const id = mode === 'today' ? 'fortune-today' : mode === 'tomorrow' ? 'fortune-tomorrow' : 'fortune-date';
const item = catalogById(id);

const copy = {
  today: {
    title: '오늘의 운세',
    lead: '오늘의 일진과 내 사주가 만나 어떤 하루가 될지 풀어 드려요.',
    desc: '생년월일로 보는 무료 오늘의 운세. 오늘의 일진과 내 사주의 관계로 총운, 연애운, 결혼운, 재물운, 직장운, 사업운, 건강운, 학업운, 대인관계운과 시간대별 흐름을 자세히 풀어 드려요.',
    article: [
      '오늘의 운세는 내 사주 여덟 글자와 오늘 하루를 다스리는 간지, 일진(日辰)이 어떻게 만나는지를 보고 풀어요. 오늘의 천간이 나에게 어떤 의미인지(십신), 오늘의 지지가 내 배우자 자리와 합을 이루는지 부딪히는지를 함께 따져서 총운 점수를 매겨요.',
      '분야별로는 연애운, 결혼운, 재물운, 직장운, 사업운, 건강운, 학업운, 대인관계운 여덟 가지를 별 다섯 개로 보여드리고, 왜 그런 흐름인지 이유와 함께 하루를 잘 보내는 방법을 알려드려요. 오전, 오후, 저녁의 시간대별 흐름과 행운의 색, 숫자, 방향도 함께 확인해 보세요.',
      '운세를 볼 때마다 이번 주 출석 도장이 하나씩 찍혀요. 매일 아침 들러서 일주일 도장을 모두 채워 보세요.',
    ],
  },
  tomorrow: {
    title: '내일의 운세',
    lead: '중요한 약속이 있다면 내일의 흐름을 미리 살펴보세요.',
    desc: '생년월일로 미리 보는 내일의 운세. 내일의 일진과 내 사주로 총운, 연애운, 재물운, 직장운, 건강운과 시간대별 흐름을 알려드려요.',
    article: [
      '내일의 운세는 내일 하루를 다스리는 일진과 내 사주의 관계를 미리 계산해서 보여드려요. 면접, 소개팅, 중요한 회의처럼 신경 쓰이는 일정이 있다면 어떤 시간대가 좋은지, 무엇을 조심하면 좋은지 미리 확인해 보세요.',
      '오늘의 운세와 같은 방식으로 총운과 여덟 가지 분야별 운세, 시간대별 흐름, 행운의 색과 숫자를 알려드려요.',
    ],
  },
  date: {
    title: '지정일 운세',
    lead: '면접, 소개팅, 이사처럼 중요한 날의 운을 골라서 보세요.',
    desc: '원하는 날짜의 운세를 생년월일로 미리 확인하는 지정일 운세. 그날의 일진과 내 사주로 총운과 분야별 운세, 좋은 시간대를 알려드려요.',
    article: [
      '지정일 운세는 내가 고른 날짜의 일진과 내 사주가 어떻게 만나는지를 보고 그날의 운을 풀어요. 이사, 계약, 면접, 데이트처럼 날짜를 정해야 할 때 후보 날짜 몇 개를 비교해 보면 도움이 돼요.',
      '총운 점수가 높고 내 배우자 자리와 합을 이루는 날은 사람과의 일에, 재물의 기운이 들어오는 날은 계약이나 거래에 좋다고 봐요. 결과는 재미로 참고해 주세요.',
    ],
  },
}[mode];

const faq = [
  { q: '운세는 언제 바뀌나요?', a: '날짜마다 일진이 달라서 자정이 지나면 새 운세로 바뀌어요. 같은 날짜, 같은 사람이라면 몇 번을 봐도 같은 결과가 나와요.' },
  { q: '태어난 시간을 모르면 어떻게 하나요?', a: '시간을 모름으로 두면 해, 달, 날의 여섯 글자로 계산해요. 하루 운세에서 가장 중요한 일간과 일지는 태어난 날로 정해져서 큰 흐름은 같아요.' },
  { q: '입력한 정보는 어디에 저장되나요?', a: '저장을 선택한 경우에만 이 기기의 브라우저에 보관돼요. 서버로는 보내지 않고, 내 정보 화면에서 언제든 지울 수 있어요.' },
];
---

<Base title={copy.title} description={copy.desc} ogImage={`/og/test-${id}.png`} crumbs={[{ name: '사주·운세', path: '/category/saju/' }, { name: copy.title, path: item.path }]} jsonLd={[faqLd(faq)]}>
  <div class="col pt-2">
    <PageHero title={copy.title} lead={copy.lead} chars={item.chars} theme={item.theme} />

    <form class="card mt-3" id="day-form" novalidate data-mode={mode}>
      <ProfileForm prefix="pa" />
      {
        mode === 'date' && (
          <div class="mt-4">
            <label class="field-label" for="day-date">
              운세를 볼 날짜
            </label>
            <input class="field" type="date" id="day-date" name="day-date" required />
          </div>
        )
      }
      <p class="mt-3 min-h-[20px] text-[13.5px] font-semibold text-jusa" id="day-error" role="alert"></p>
      <button type="submit" class="btn btn-primary btn-block mt-1">{copy.title} 보기</button>
    </form>

    <AdSlot name="test-intro" />

    <article class="card prose-lab">
      <h2>{copy.title}는 이렇게 풀어요</h2>
      {copy.article.map((p) => <p>{p}</p>)}
    </article>

    <section class="card" aria-labelledby="faq">
      <h2 id="faq" class="card-title">자주 묻는 질문</h2>
      <Faq items={faq} />
    </section>

    <Related id={id} />
    <Disclaimer />
  </div>
  <Gate slot="overlay" />
</Base>

<script>
  import { readProfileForm } from '../lib/profile-form';
  import { saveProfile, setPending, honor } from '../lib/profile';
  import { openGate } from '../lib/gate';
  import { todayKST } from '../lib/ui';

  const form = document.getElementById('day-form') as HTMLFormElement;
  const mode = form.dataset.mode as 'today' | 'tomorrow' | 'date';
  const err = document.getElementById('day-error')!;
  const today = todayKST();
  const shift = (ymd: string, n: number) => {
    const [y, m, d] = ymd.split('-').map(Number);
    return new Date(Date.UTC(y, m - 1, d + n)).toISOString().slice(0, 10);
  };
  const dateInput = document.getElementById('day-date') as HTMLInputElement | null;
  if (dateInput) {
    dateInput.value = shift(today, 7);
    dateInput.min = '1950-01-01';
    dateInput.max = '2100-12-31';
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const p = readProfileForm(form, 'pa');
    if (typeof p === 'string') return void (err.textContent = p);
    let date = mode === 'today' ? today : mode === 'tomorrow' ? shift(today, 1) : (dateInput?.value ?? '');
    if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) return void (err.textContent = '날짜를 골라 주세요');
    err.textContent = '';
    const { save, ...profile } = p;
    if (save) saveProfile(profile);
    setPending({ kind: 'day', a: profile, date });
    const label = mode === 'today' ? '오늘의 운세' : mode === 'tomorrow' ? '내일의 운세' : `${Number(date.slice(5, 7))}월 ${Number(date.slice(8))}일 운세`;
    openGate({
      name: `${honor(profile.name)}의 `,
      label: `${label}를 풀이하고 있어요`,
      steps: ['사주 여덟 글자를 세우는 중', '그날의 일진을 찾는 중', '분야별 운을 계산하는 중', '풀이를 정리하는 중'],
      href: `/fortune/result/?m=${mode}`,
      chars: ['sun', 'rabbit', 'tiger'],
      test: `fortune-${mode}`,
    });
  });
</script>
