---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import Faq from '../../components/Faq.astro';
import Related from '../../components/Related.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import ShareBar from '../../components/ShareBar.astro';
import { DREAMS, DREAM_CATS, SIGN_NAME, type Dream } from '../../data/dreams';
import { charSvg, sceneSvg } from '../../art/characters';
import { iconSvg } from '../../art/icons';
import { faqLd } from '../../lib/seo';

export function getStaticPaths() {
  return DREAMS.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}
const { d } = Astro.props as { d: Dream };
const same = DREAMS.filter((x) => x.cat === d.cat && x !== d).slice(0, 4);
const path = `/dream/${d.slug}/`;
const faq = [
  { q: `${d.name}은 길몽인가요?`, a: `${d.summary} ${d.meaning[0]}` },
  ...d.cases.slice(0, 2).map(([q, a]) => ({ q: `${q}은 무슨 뜻인가요?`, a })),
];
---

<Base
  title={`${d.name} 해몽, ${d.cases.map((c) => c[0]).join(', ')}`}
  description={`${d.name} 해몽. ${d.summary} ${d.cases.map((c) => c[0]).join(', ')}의 뜻까지 상황별로 풀어 드려요.`}
  ogImage="/og/test-dream.png"
  crumbs={[{ name: '꿈해몽', path: '/dream/' }, { name: d.name, path }]}
  jsonLd={[faqLd(faq)]}
  back="/dream/"
  headerTitle="꿈해몽"
>
  <div class="col pt-2">
    <section class="card text-center">
      <span class="mx-auto block h-40 w-40" set:html={sceneSvg({ chars: [d.char], theme: 'night', mood: d.sign === 'caution' ? 'normal' : 'happy' })} />
      <p class="mt-2 text-[14px] font-semibold text-ink-2">{DREAM_CATS[d.cat]} 꿈</p>
      <h1 class="font-display mt-1 text-[30px] leading-tight font-extrabold">{d.name} 해몽</h1>
      <span class={`tag mt-2 ${d.sign === 'caution' ? 'tag-red' : ''}`}>{SIGN_NAME[d.sign]}</span>
      <p class="mt-3 text-[16px] leading-relaxed">{d.summary}</p>
    </section>

    <section class="card reading-block">
      <div class="reading-head"><span class="ico" set:html={iconSvg('tomorrow', 28)} /><h2 class="flex-1">{d.name}의 뜻</h2></div>
      <div class="reading-text">{d.meaning.map((p) => <p class="mt-2 first:mt-0">{p}</p>)}</div>
    </section>

    <AdSlot name="result-top" />

    <section class="card reading-block">
      <div class="reading-head"><span class="ico" set:html={iconSvg('types', 28)} /><h2 class="flex-1">상황별 풀이</h2></div>
      <ul class="space-y-4">
        {
          d.cases.map(([t, x]) => (
            <li>
              <h3 class="text-[16px] font-bold">{t}</h3>
              <p class="mt-1 text-[15.5px] leading-relaxed">{x}</p>
            </li>
          ))
        }
      </ul>
      <div class="mt-4 rounded-[14px] bg-[var(--wash)] px-4 py-3">
        <p class="text-[13px] font-bold text-jusa">이렇게 해 보세요</p>
        <p class="mt-1 text-[15px]">{d.tip}</p>
      </div>
    </section>

    <section class="card">
      <ShareBar title={`${d.name} 해몽: ${d.summary}`} text="어젯밤 꿈, 무슨 뜻일까? 꿈해몽 사전에서 찾아봐" path={path} ctaPath="/dream/" ogImage="/og/test-dream.png" campaign="dream" />
      <a href="/fortune/today/" class="btn btn-hwang btn-block mt-4">꿈 꾼 오늘, 내 운세 보기</a>
    </section>

    <section class="card">
      <h2 class="card-title">{DREAM_CATS[d.cat]} 꿈 더 보기</h2>
      <ul class="mt-2 grid grid-cols-2 gap-2">
        {
          same.map((x) => (
            <li>
              <a href={`/dream/${x.slug}/`} class="flex items-center gap-2 rounded-[14px] bg-[var(--wash)] p-3">
                <span class="block h-10 w-10 flex-none" set:html={charSvg(x.char, 'happy')} />
                <span class="text-[15px] font-semibold">{x.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/dream/" class="btn btn-line btn-block mt-3">꿈해몽 사전 전체 보기</a>
    </section>

    <section class="card">
      <h2 class="card-title">자주 묻는 질문</h2>
      <Faq items={faq} />
    </section>
    <Related id="dream" />
    <Disclaimer />
  </div>
</Base>
