---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import Related from '../../components/Related.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import AdSlot from '../../components/AdSlot.astro';
import MbtiSelect from '../../components/MbtiSelect.astro';
import { MBTI_CODES } from '../../data/mbti/types';
import { mbtiScore, tierOf, pairSlug } from '../../data/mbti/compat';
import { faqLd } from '../../lib/seo';

const levels = [
  { name: '천생연분', min: 90, color: 'var(--jusa)', op: 1 },
  { name: '찰떡궁합', min: 83, color: 'var(--jusa)', op: 0.62 },
  { name: '잘 맞는 편', min: 77, color: 'var(--jusa)', op: 0.32 },
  { name: '노력형 궁합', min: 70, color: 'var(--ink-3)', op: 0.28 },
  { name: '롤러코스터', min: 0, color: 'var(--ink-3)', op: 0.6 },
];
function level(s: number) {
  return levels.find((l) => s >= l.min)!;
}

const faq = [
  {
    q: 'MBTI 궁합 점수는 어떻게 계산하나요?',
    a: '정보를 받아들이는 방식(N/S)이 같으면 대화가 잘 통한다고 보고 가장 크게 반영해요. 에너지 방향(E/I)과 생활 리듬(J/P)은 서로 다를 때 보완이 된다고 보고, 판단 기준(T/F)은 둘 다 F일 때 가장 높게 매겨요.',
  },
  { q: '같은 유형끼리는 궁합이 어떤가요?', a: '같은 유형끼리는 점수 대신 거울 궁합으로 따로 보여드려요. 말이 잘 통하는 대신 단점도 똑같이 닮아서 생기는 재미있는 순간이 많아요.' },
  { q: '궁합이 낮게 나오면 안 맞는 건가요?', a: '아니요. 재미로 보는 점수예요. 다른 점이 많은 사이일수록 서로에게 배울 게 많다는 뜻이기도 해요.' },
];
---

<Base
  title="MBTI 궁합표 – 16유형 256가지 조합"
  description="MBTI 16유형끼리의 궁합을 한눈에 보는 궁합표. 내 유형과 상대 유형을 고르면 대화, 감정, 생활 리듬, 싸울 때 모습까지 자세한 궁합을 알려드려요."
  ogImage="/og/test-mbti-match.png"
  crumbs={[{ name: 'MBTI 궁합', path: '/mbti-match/' }]}
  jsonLd={[faqLd(faq)]}
>
  <div class="col pt-2">
    <PageHero title="MBTI 궁합" lead="두 사람의 유형을 고르면 대화가 통하는 정도부터 싸울 때 모습까지 알려드려요." chars={['monkey', 'hawk']} theme="love" />

    <form class="card mt-3" id="match-form" action="/mbti-match/" method="get">
      <div class="grid grid-cols-2 gap-3">
        <div><MbtiSelect name="a" label="나" compact /></div>
        <div><MbtiSelect name="b" label="상대" compact /></div>
      </div>
      <button type="submit" class="btn btn-primary btn-block mt-4">궁합 보기</button>
      <p class="mt-2 text-center text-[13.5px] text-ink-3">
        내 유형을 모르면 <a href="/test/mbti/" class="font-semibold underline underline-offset-2">3분 검사</a>부터 해 보세요
      </p>
    </form>

    <section class="card" aria-labelledby="chart">
      <h2 id="chart" class="card-title">한눈에 보는 궁합표</h2>
      <p class="mt-1 text-[14.5px] text-ink-2">칸을 누르면 그 조합의 자세한 궁합으로 가요.</p>
      <div class="chart mt-5" role="table" aria-label="MBTI 궁합표">
        <div class="chart-corner" aria-hidden="true"></div>
        {
          MBTI_CODES.map((c) => (
            <div class="chart-col" role="columnheader">
              {c}
            </div>
          ))
        }
        {
          MBTI_CODES.map((a) => (
            <>
              <div class="chart-row" role="rowheader">
                {a}
              </div>
              {MBTI_CODES.map((b) => {
                const s = mbtiScore(a, b);
                const lv = level(s);
                const same = a === b;
                return (
                  <a
                    href={`/mbti-match/${pairSlug(a, b)}/`}
                    class:list={['chart-cell', { same }]}
                    style={same ? '' : `--c:${lv.color};--o:${lv.op}`}
                    role="cell"
                    title={`${a} × ${b} ${s}점 ${tierOf(s, same).name}`}
                    aria-label={`${a}와 ${b} ${same ? '거울 궁합' : `${s}점`}`}
                  />
                );
              })}
            </>
          ))
        }
      </div>
      <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-[13px] font-semibold text-ink-2">
        {
          levels.map((l) => (
            <li class="flex items-center gap-1.5">
              <span class="legend" style={`--c:${l.color};--o:${l.op}`} />
              {l.name}
            </li>
          ))
        }
        <li class="flex items-center gap-1.5"><span class="legend same"></span>거울 궁합</li>
      </ul>
    </section>

    <AdSlot name="list-infeed" format="fluid" />

    <article class="card prose-lab">
      <h2>궁합은 이렇게 봐요</h2>
      <p>
        MBTI 궁합은 두 사람의 네 가지 성향이 어떻게 맞물리는지를 보고 점수를 매겨요. 가장 크게 보는 건 정보를 받아들이는 방식이에요.
        큰 그림과 가능성을 보는 N끼리, 구체적인 현실을 보는 S끼리는 대화의 결이 비슷해서 이야기가 잘 통해요.
      </p>
      <p>
        에너지 방향(E/I)과 생활 리듬(J/P)은 오히려 서로 다를 때 빈자리를 채워 준다고 봤어요. 밖으로 이끄는 사람과 쉴 자리를 만드는 사람,
        계획을 세우는 사람과 즉흥의 재미를 더하는 사람처럼요. 판단 기준(T/F)은 둘 다 감정을 중시할 때 가장 따뜻하다고 보고 조금 더 점수를
        줬어요.
      </p>
      <p>
        점수는 64점부터 95점 사이로 나오고, 다섯 단계로 나눠서 보여드려요. 같은 유형끼리는 점수 대신 거울 궁합으로 따로 풀어 드려요.
      </p>
    </article>

    <section class="card" aria-labelledby="faq">
      <h2 id="faq" class="card-title">자주 묻는 질문</h2>
      <Faq items={faq} />
    </section>

    <Related id="mbti-match" />
    <Disclaimer mbti />
  </div>
</Base>

<style>
  .chart {
    display: grid;
    grid-template-columns: 36px repeat(16, minmax(0, 1fr));
    gap: 2px;
    font-family: 'Hahmlet Variable', serif;
  }
  .chart-col {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 9.5px;
    min-width: 0;
    font-weight: 700;
    color: var(--ink-2);
    text-align: left;
    justify-self: center;
    padding-top: 2px;
    letter-spacing: 0.02em;
  }
  .chart-row {
    font-size: 10px;
    font-weight: 700;
    color: var(--ink-2);
    align-self: center;
  }
  .chart-cell {
    aspect-ratio: 1;
    border-radius: 3px;
    position: relative;
    background: var(--wash);
  }
  .chart-cell::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--c);
    opacity: var(--o);
  }
  .chart-cell.same {
    background: var(--hwang);
  }
  .chart-cell.same::before {
    display: none;
  }
  .chart-cell:hover {
    outline: 2px solid var(--ink);
    outline-offset: 1px;
    z-index: 1;
  }
  .legend {
    position: relative;
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background: var(--wash);
    overflow: hidden;
  }
  .legend::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--c);
    opacity: var(--o);
  }
  .legend.same {
    background: var(--hwang);
  }
  .legend.same::before {
    display: none;
  }
</style>

<script>
  const form = document.getElementById('match-form') as HTMLFormElement;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const a = String(fd.get('a') || '');
    const b = String(fd.get('b') || '');
    if (!a || !b) return;
    location.href = `/mbti-match/${a.toLowerCase()}-${b.toLowerCase()}/`;
  });
</script>
