---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { charSvg, MBTI_CHAR } from '../../art/characters';
import Related from '../../components/Related.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import AdSlot from '../../components/AdSlot.astro';
import { MBTI, MBTI_GROUPS } from '../../data/mbti/types';
---

<Base
  title="MBTI 16유형 해설"
  description="MBTI 16가지 유형의 성격, 연애, 직장, 친구 관계 특징을 한곳에 정리했어요. INTJ부터 ESFP까지 내 유형과 친구 유형을 찾아보세요."
  ogImage="/og/test-mbti-types.png"
  crumbs={[{ name: 'MBTI 16유형 해설', path: '/mbti/' }]}
>
  <div class="col pt-2">
    <PageHero title="MBTI 16유형 해설" lead="유형마다 연애할 때, 일할 때, 친구와 있을 때 모습을 정리했어요. 유형마다 닮은 동물 친구도 있어요." chars={['cat', 'hawk', 'rabbit', 'horse']} theme="work" />
    <a href="/test/mbti/" class="btn btn-primary btn-block mt-3">3분 MBTI 검사하기</a>

    {
      MBTI_GROUPS.map((g, gi) => (
        <>
          <section class="card mt-3">
            <h2 class="card-title">{g.name}</h2>
            <ul class="rows mt-2">
              {g.codes.map((c) => (
                <li>
                  <a href={`/mbti/${c.toLowerCase()}/`} class="row-link">
                    <span class="thumb" set:html={charSvg(MBTI_CHAR[c], 'happy')} />
                    <span class="min-w-0 flex-1">
                      <span class="row-title block text-[17px] font-semibold">
                        {c} {MBTI[c].name}
                      </span>
                      <span class="block text-[14px] leading-snug text-ink-2">{MBTI[c].line}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
          {gi === 1 && <AdSlot name="list-infeed" format="fluid" />}
        </>
      ))
    }

    <a href="/mbti-match/" class="btn btn-line btn-block mt-3">MBTI 궁합표 보기</a>
    <Related id="mbti-types" />
    <Disclaimer mbti />
  </div>
</Base>
