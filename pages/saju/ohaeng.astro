---
import InputPage from '../../components/InputPage.astro';
import { ELEMENTS, ELEMENT_ORDER } from '../../data/saju';

const faq = [
  { q: '오행이 뭔가요?', a: '세상의 기운을 나무(木), 불(火), 흙(土), 쇠(金), 물(水) 다섯 가지로 나눠 보는 동양의 생각이에요. 사주 여덟 글자는 모두 이 다섯 기운 중 하나에 속해요.' },
  { q: '부족한 오행은 어떻게 정하나요?', a: '사주 여덟 글자(시간을 모르면 여섯 글자)에 들어 있는 오행의 개수를 세서 가장 적은 기운을 골라요. 같은 개수라면 나무, 불, 흙, 쇠, 물 순서로 앞에 있는 기운을 먼저 보여드려요.' },
  { q: '행운의 색을 쓰면 정말 도움이 되나요?', a: '재미로 즐기는 생활 팁이에요. 부족한 기운을 떠올리며 작은 습관을 하나 바꿔 보는 건 기분 전환에 꽤 도움이 돼요.' },
];
---

<InputPage
  id="ohaeng"
  title="오행 부족 진단"
  lead="사주에 담긴 다섯 기운을 세어서 나에게 모자란 기운과 채우는 방법을 알려드려요."
  desc="생년월일로 사주 오행을 세서 나에게 부족한 기운을 찾아 드려요. 나무, 불, 흙, 쇠, 물 중 모자란 기운과 그 기운을 채워 주는 행운의 색, 숫자, 방향, 음식까지 알려드려요."
  articleTitle="다섯 기운과 행운의 아이템"
  article={[
    '오행은 나무, 불, 흙, 쇠, 물의 다섯 기운이에요. 서로 돕기도 하고 누르기도 하면서 균형을 이룬다고 봐요. 사주 여덟 글자 안에 특정 기운이 너무 적으면, 그 기운이 맡은 성질이 조금 약하게 드러난다고 해석해요.',
    '부족한 기운의 색을 옷이나 소품에 쓰고, 그 기운에 어울리는 습관을 하나씩 들이면 균형을 맞추는 데 도움이 된다고 해요.',
  ]}
  faq={faq}
  kind="ohaeng"
  resultPath="/saju/ohaeng/result/"
  gateLabel="오행의 균형을 살피고 있어요"
  gateSteps={['사주 여덟 글자를 세우는 중', '다섯 기운의 개수를 세는 중', '부족한 기운을 찾는 중', '행운 아이템을 고르는 중']}
  submitLabel="부족한 기운 찾기"
  chars={['tree', 'sun', 'mountain']}
>
  <ul slot="article" class="mt-3">
    {
      ELEMENT_ORDER.map((k) => (
        <li>
          <strong>
            {ELEMENTS[k].name}({ELEMENTS[k].hanja})
          </strong>
          : {ELEMENTS[k].season}의 기운. 색은 {ELEMENTS[k].colorName}, 숫자는 {ELEMENTS[k].numbers}, 방향은 {ELEMENTS[k].direction}이에요.
        </li>
      ))
    }
  </ul>
</InputPage>
