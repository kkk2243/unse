---
import Base from '../layouts/Base.astro';
import TestList from '../components/TestList.astro';
import { featured } from '../data/catalog';
import { charSvg } from '../art/characters';
---

<Base title="페이지를 찾을 수 없어요" noindex back="/" headerTitle="길을 잃었어요">
  <div class="col pt-2">
    <section class="card text-center">
      <span class="mx-auto block h-24 w-24" set:html={charSvg('owl', 'normal')} />
      <h1 class="mt-2 text-[22px] font-extrabold leading-tight">이 주소에는 아무것도 없어요</h1>
      <p class="mt-2 text-[15px] text-ink-2">주소가 바뀌었거나 잘못 입력됐을 수 있어요.<br />대신 이런 운세는 어때요?</p>
      <a href="/" class="btn btn-primary btn-block mt-5">처음으로 가기</a>
    </section>
    <div class="mt-3"><TestList items={featured(5)} /></div>
  </div>
</Base>
